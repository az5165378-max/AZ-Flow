    // Render Full List in ScreenCustomers
    function renderRecordsList() {
      const container = document.getElementById("recordsContainer");
      if (!container) return;

      const q = (document.getElementById("customerSearchInput")?.value || "").toLowerCase().trim();
      const filter = document.getElementById("customerFilterStatus")?.value || "all";

      let filtered = customerRecords.filter(r => {
        const matchesQuery = !q ||
          (r.name && r.name.toLowerCase().includes(q)) ||
          (r.phone1 && r.phone1.includes(q)) ||
          (r.work && r.work.toLowerCase().includes(q));

        if (!matchesQuery) return false;
        if (filter === "done") return r.status === "مکمل ہو گیا";
        if (filter === "pending") return r.status !== "مکمل ہو گیا";
        return true;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div style="text-align:center; padding:40px 20px; background:#fff; border-radius:16px; border:1px solid #e2e8f0;">
            <div style="font-size:36px; margin-bottom:8px;">🔍</div>
            <div style="font-weight:800; font-size:14px; color:#334155;">کوئی ریکارڈ نہیں ملا</div>
            <div style="font-size:11.5px; color:#94a3b8; margin-top:4px;">نیا کسٹمر شامل کرنے کے لیے اوپر بٹن دبائیں۔</div>
          </div>`;
        return;
      }

      container.innerHTML = filtered.map(r => generateCustomerCardHtml(r)).join("");
    }

    // High Quality Customer Card with Full Financials & Status Prominence
    function generateCustomerCardHtml(item) {
      const isDone = item.status === "مکمل ہو گیا";
      const totalAmount = item.amount || 0;
      const costFee = item.fee || 0;
      const profit = item.profit !== undefined ? item.profit : (totalAmount - costFee);

      return `
        <div class="item-card ${isDone ? 'is-done' : 'is-pending'}">
          <div class="item-header">
            <div>
              <div class="item-customer-name">${escapeHtml(item.name)}</div>
              <div class="item-work">${escapeHtml(item.work || 'عام سروس')}</div>
            </div>
            <div style="text-align:left;">
              <div class="item-date">📅 ${escapeHtml(item.date || '')}</div>
              ${item.phone1 ? `<div style="font-size:11.5px; color:#0284c7; font-weight:700;">📞 ${escapeHtml(item.phone1)}</div>` : ''}
            </div>
          </div>

          <!-- Prominent High-Contrast Status Badge -->
          <div>
            <span class="status-badge ${isDone ? 'badge-done' : 'badge-pending'}">
              ${isDone ? '✅ کام مکمل ہو گیا ہے' : '⏳ کام پر کام جاری ہے'}
            </span>
          </div>

          <!-- Professional Digital Receipt Breakdown -->
          <div class="receipt-box">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; border-bottom:1px dashed #cbd5e1; padding-bottom:4px;">
              <span style="font-size:11px; font-weight:800; color:#475569;">🧾 ڈیجیٹل رسید و کھاتہ حساب</span>
              <span style="font-size:10px; color:#64748b;">AZ Flow</span>
            </div>
            <div class="receipt-row">
              <span style="color:#334155;">کل وصولی فیس (Total Fee):</span>
              <span class="val" style="color:#0284c7;">Rs. ${totalAmount.toLocaleString()}</span>
            </div>
            <div class="receipt-row">
              <span style="color:#334155;">اب تک وصول رقم:</span>
              <span class="val" style="color:#0284c7;">Rs. ${(item.paidAmount ?? item.amount ?? 0).toLocaleString()}</span>
            </div>
            <div class="receipt-row">
              <span style="color:#334155;">باقی وصولی:</span>
              <span class="val" style="color:#b45309;">Rs. ${(item.balanceAmount ?? 0).toLocaleString()}</span>
            </div>
            <div class="receipt-row">
              <span style="color:#334155;">لاگت فیس / سرکاری خرچ (Cost):</span>
              <span class="val" style="color:#e11d48;">Rs. ${costFee.toLocaleString()}</span>
            </div>
            <div class="receipt-row bold">
              <span style="color:#0f172a;">باقی رقم / خالص بچت (Profit):</span>
              <span class="val" style="color:#059669; font-size:14px;">Rs. ${profit.toLocaleString()}</span>
            </div>
          </div>

          <!-- Actions -->
          ${item.additionalDetails ? `<div style="font-size:11.5px;color:#475569;margin:8px 0;"><b>اضافی تفصیل:</b> ${escapeHtml(item.additionalDetails)}</div>` : ''}
          ${item.dueDate ? `<div style="font-size:11.5px;color:#b45309;margin:5px 0;">📅 باقی ادائیگی کی تاریخ: ${escapeHtml(item.dueDate)}</div>` : ''}
          <div class="item-actions">
            <button class="btn btn-primary" onclick="viewCustomerReceipt(${item.id})">🧾 رسید دیکھیں</button><button class="btn btn-outline" onclick="exportCustomerPDF(${item.id})">📄 PDF اسٹیٹمنٹ</button>
            <button class="btn btn-outline" style="border-color:${isDone ? '#f59e0b' : '#10b981'}; color:${isDone ? '#d97706' : '#059669'};" onclick="toggleCustomerStatus(${item.id})">
              ${isDone ? '↩️ زیرِ التواء کریں' : '✔️ کام مکمل کریں'}
            </button>
            <button class="btn btn-whatsapp" style="padding:6px 10px;" onclick="sendCustomerWhatsAppReceipt(${item.id})">
              <span>💬</span> رسید بھیجیں
            </button>
            <button class="btn btn-outline" onclick="openEditCustomerModal(${item.id})">✏️ ترمیم</button>
            <button class="btn btn-outline" style="color:#ef4444; border-color:#fca5a5;" onclick="deleteCustomer(${item.id})">🗑️</button>
          </div>
        </div>
      `;
    }

    // UDHAAR KHATA (ادھار کھاتہ بک) LOGIC
    function setUdhaarFilter(f) {
      currentUdhaarFilter = f;
      document.getElementById("udhaarTabAll").style.background = (f === "all") ? "#fff" : "transparent";
      document.getElementById("udhaarTabLena").style.background = (f === "lena") ? "#fff" : "transparent";
      document.getElementById("udhaarTabDena").style.background = (f === "dena") ? "#fff" : "transparent";
      renderUdhaarList();
    }

    function selectUdhaarType(type) {
      activeUdhaarType = type;
      const btnLena = document.getElementById("btnTypeLena");
      const btnDena = document.getElementById("btnTypeDena");
      if (type === "lena") {
        btnLena.style.background = "#10b981";
        btnLena.style.color = "#fff";
        btnDena.style.background = "#f1f5f9";
        btnDena.style.color = "#475569";
      } else {
        btnDena.style.background = "#ef4444";
        btnDena.style.color = "#fff";
        btnLena.style.background = "#f1f5f9";
        btnLena.style.color = "#475569";
      }
    }

    function openNewUdhaarModal() {
      activeUdhaarEditId = null;
      document.getElementById("modalUdhaarTitle").innerText = "نیا ادھار کھاتہ درج کریں";
      document.getElementById("inputUdhaarPerson").value = "";
      document.getElementById("inputUdhaarAmount").value = "";
      document.getElementById("inputUdhaarPhone").value = "";
      document.getElementById("inputUdhaarDetails").value = "";
      document.getElementById("inputUdhaarDueDate").value = "";
      const extraNew = document.getElementById("inputUdhaarExtra"); if (extraNew) extraNew.value = "";
      selectUdhaarType("lena");
      document.getElementById("modalUdhaar").style.display = "flex";
    }

    function openEditUdhaarModal(id) {
      const rec = udhaarRecords.find(u => String(u.id) === String(id));
      if (!rec) { showToast("ریکارڈ نہیں ملا۔", "⚠️"); return; }
      activeUdhaarEditId = rec.id;
      document.getElementById("modalUdhaarTitle").innerText = "ادھار کھاتہ میں ترمیم کریں";
      document.getElementById("inputUdhaarPerson").value = rec.personName || "";
      document.getElementById("inputUdhaarAmount").value = rec.amount || "";
      document.getElementById("inputUdhaarPhone").value = rec.phone || "";
      document.getElementById("inputUdhaarDetails").value = rec.details || "";
      document.getElementById("inputUdhaarDueDate").value = rec.dueDate || "";
      const extra = document.getElementById("inputUdhaarExtra"); if (extra) extra.value = rec.additionalDetails || "";
      selectUdhaarType(rec.type === "dena" ? "dena" : "lena");
      document.getElementById("modalUdhaar").style.display = "flex";
    }

    function closeUdhaarModal() {
      document.getElementById("modalUdhaar").style.display = "none";
      activeUdhaarEditId = null;
    }

    function submitUdhaarForm() {
      const personName = document.getElementById("inputUdhaarPerson").value.trim();
      const amount = parseFloat(document.getElementById("inputUdhaarAmount").value) || 0;
      const phone = document.getElementById("inputUdhaarPhone").value.trim();
      const details = document.getElementById("inputUdhaarDetails").value.trim();
      const dueDate = document.getElementById("inputUdhaarDueDate").value;
      const additionalDetails = document.getElementById("inputUdhaarExtra")?.value.trim() || "";

      if (!personName) {
        showToast("براہ کرم شخص کا نام درج کریں!", "⚠️");
        return;
      }
      if (amount <= 0) {
        showToast("براہ کرم ادھار کی درست رقم درج کریں!", "⚠️");
        return;
      }

      const todayStr = new Date().toLocaleDateString("en-GB");

      if (activeUdhaarEditId) {
        const idx = udhaarRecords.findIndex(u => u.id === activeUdhaarEditId);
        if (idx !== -1) {
          udhaarRecords[idx] = {
            ...udhaarRecords[idx],
            personName, amount, phone, details, dueDate, additionalDetails,
            type: activeUdhaarType,
            updatedAt: Date.now()
          };
          showToast("ادھار کھاتہ اپڈیٹ ہو گیا!");
        }
      } else {
        const item = {
          id: Date.now(),
          personName, amount, phone, details, dueDate, additionalDetails,
          type: activeUdhaarType,
          date: todayStr,
          settled: false,
          createdAt: Date.now()
        };
        udhaarRecords.unshift(item);
        showToast("نیا ادھار کامیابی سے درج ہو گیا!");
      }

      commitStorageData();
      closeUdhaarModal();
      refreshDashboardMetrics();
      renderUdhaarList();
    }

    function toggleUdhaarSettled(id) {
      const idx = udhaarRecords.findIndex(u => u.id === id);
      if (idx !== -1) {
        udhaarRecords[idx].settled = !udhaarRecords[idx].settled;
        commitStorageData();
        refreshDashboardMetrics();
        renderUdhaarList();
        showToast(udhaarRecords[idx].settled ? "ادائیگی مکمل نشان زد ہو گئی!" : "کھاتہ دوبارہ فعال ہو گیا");
      }
    }

    function deleteUdhaar(id) {
      if (confirm("کیا آپ واقعی یہ ادھار کھاتہ ڈیلیٹ کرنا چاہتے ہیں؟")) {
        udhaarRecords = udhaarRecords.filter(u => u.id !== id);
        commitStorageData();
        refreshDashboardMetrics();
        renderUdhaarList();
        showToast("ادھار ریکارڈ حذف ہو گیا", "🗑️");
      }
    }

    function renderUdhaarList() {
      const container = document.getElementById("udhaarContainer");
      if (!container) return;

      const q = (document.getElementById("udhaarSearchInput")?.value || "").toLowerCase().trim();

      let receivable = 0;
      let payable = 0;

      let filtered = udhaarRecords.filter(u => {
        if (!u.settled) {
          if (u.type === "lena") receivable += (u.amount || 0);
          else payable += (u.amount || 0);
        }

        const matchesQuery = !q ||
          (u.personName && u.personName.toLowerCase().includes(q)) ||
          (u.phone && u.phone.includes(q)) ||
          (u.details && u.details.toLowerCase().includes(q));

        if (!matchesQuery) return false;
        if (currentUdhaarFilter === "lena") return u.type === "lena";
        if (currentUdhaarFilter === "dena") return u.type === "dena";
        return true;
      });

      // Update Net
      const net = receivable - payable;
      const netEl = document.getElementById("udhaarNetBalance");
      const netSub = document.getElementById("udhaarNetSubtext");
      if (netEl) {
        netEl.innerText = "Rs. " + Math.abs(net).toLocaleString();
        if (net >= 0) {
          netEl.style.color = "#4ade80";
          if (netSub) netSub.innerText = "آپ کو کل Rs. " + net.toLocaleString() + " لینے ہیں (بچت میں اضافہ)";
        } else {
          netEl.style.color = "#f87171";
          if (netSub) netSub.innerText = "آپ کو کل Rs. " + Math.abs(net).toLocaleString() + " ادا کرنے ہیں";
        }
      }

      if (filtered.length === 0) {
        container.innerHTML = `
          <div style="text-align:center; padding:40px 20px; background:#fff; border-radius:16px; border:1px solid #e2e8f0;">
            <div style="font-size:36px; margin-bottom:8px;">📒</div>
            <div style="font-weight:800; font-size:14px; color:#334155; margin-bottom:4px;">کوئی ادھار کھاتہ نہیں ملا</div>
            <div style="font-size:11.5px; color:#94a3b8;">نیا ادھار درج کرنے کے لیے اوپر بٹن دبائیں۔</div>
          </div>`;
        return;
      }

      container.innerHTML = filtered.map(u => {
        const isLena = u.type === "lena";
        const isSettled = u.settled;

        return `
          <div class="item-card" style="border-right: 5px solid ${isSettled ? '#94a3b8' : (isLena ? '#10b981' : '#ef4444')}; opacity:${isSettled ? '0.65' : '1'};">
            <div class="item-header">
              <div>
                <div class="item-customer-name">${escapeHtml(u.personName)}</div>
                <div style="font-size:12px; color:#64748b; font-weight:700;">${escapeHtml(u.details || 'تفصیل موجود نہیں')}</div>
              </div>
              <div style="text-align:left;">
                <div style="font-size:18px; font-weight:900; color:${isLena ? '#059669' : '#dc2626'};">
                  Rs. ${(u.amount || 0).toLocaleString()}
                </div>
                <span class="udhaar-badge ${isLena ? 'udhaar-lena' : 'udhaar-dena'}">
                  ${isLena ? '⬇️ وصول کرنا ہے (لینا ہے)' : '⬆️ ادا کرنا ہے (دینا ہے)'}
                </span>
              </div>
            </div>

            <div style="font-size:11.5px; color:#475569; margin:6px 0; display:flex; gap:14px; flex-wrap:wrap;">
              <span>📅 درج تاریخ: ${escapeHtml(u.date || '')}</span>
              ${u.dueDate ? `<span style="color:#d97706; font-weight:700;">⏳ وعدہ: ${escapeHtml(u.dueDate)}</span>` : ''}
              ${u.phone ? `<span>📞 ${escapeHtml(u.phone)}</span>` : ''}
            </div>

            ${isSettled ? `
              <div style="background:#f1f5f9; color:#475569; font-size:11.5px; font-weight:800; padding:4px 10px; border-radius:6px; display:inline-block; margin:4px 0;">
                ✔️ ادائیگی مکمل ہو چکی ہے
              </div>
            ` : ''}

            ${u.additionalDetails ? `<div style="font-size:11.5px;color:#475569;margin:8px 0;"><b>اضافی تفصیل:</b> ${escapeHtml(u.additionalDetails)}</div>` : ''}
            <div class="item-actions">
              <button class="btn btn-primary" onclick="viewUdhaarReceipt(${u.id})">🧾 رسید دیکھیں</button>
              <button class="btn btn-outline" onclick="azRecordStatement('udhaar',${u.id})">📄 اسٹیٹمنٹ PDF</button>
              <button class="btn btn-whatsapp" onclick="sendUdhaarReceipt(${u.id})">🟢 رسید بھیجیں</button>
              <button class="btn btn-outline" style="border-color:${isSettled ? '#94a3b8' : '#10b981'}; color:${isSettled ? '#475569' : '#059669'};" onclick="toggleUdhaarSettled(${u.id})">
                ${isSettled ? '↩️ دوبارہ ادھار کریں' : '✔️ وصول / ادا ہو گیا'}
              </button>
              ${isLena && !isSettled ? `
                <button class="btn btn-whatsapp" style="padding:6px 10px;" onclick="sendUdhaarReminder(${u.id})">
                  <span>💬</span> یاد دہانی میسج
                </button>
              ` : ''}
              <button class="btn btn-edit" onclick="openEditUdhaarModal(${u.id})">✏️ ترمیم</button>
              <button class="btn btn-outline" style="color:#ef4444; border-color:#fca5a5; flex:none; width:44px;" aria-label="ڈیلیٹ" onclick="deleteUdhaar(${u.id})">🗑️</button>
            </div>
          </div>
        `;
      }).join("");
    }

    function sendUdhaarReceipt(id) {
      const item = udhaarRecords.find(u => u.id === id); if (!item) return; viewUdhaarReceipt(id); return;
      const msg = `🧾 *AZ Flow — ادھار رسید*\n━━━━━━━━━━━━━━━━━━\nرسید نمبر: AZ-U-${item.id}\nنام: ${item.personName || "—"}\nتاریخ: ${item.date || "—"}\nکھاتے کی قسم: ${item.type === "lena" ? "کسٹمر سے رقم وصول کرنی ہے" : "رقم ادا کرنی ہے"}\n\nسامان / کام کی تفصیل: ${item.details || "درج نہیں"}\nادھار کی رقم: Rs. ${(Number(item.amount)||0).toLocaleString()}\nواپسی کی تاریخ: ${item.dueDate || "درج نہیں"}\nحالت: ${item.settled ? "ادائیگی مکمل" : "بقایا"}\nاضافی تفصیل: ${item.additionalDetails || "درج نہیں"}${senderReceiptText()}\n\n*Powered by AZ Flow*`;
      saveReceiptPNG(true);
    }

    // WhatsApp Reminder for Udhaar
    function sendUdhaarReminder(id) {
      const item = udhaarRecords.find(u => u.id === id);
      if (!item) return;

      const msg = `السلام علیکم محترم *${item.personName}* صاحب!\nامید ہے آپ خیریت سے ہوں گے۔\n\n📌 *AZ Flow کھاتہ بک کی جانب سے یاد دہانی:*\n${item.details ? `مد / تفصیل: *${item.details}*\n` : ''}واجب الادا بقایا رقم: *Rs. ${(item.amount || 0).toLocaleString()}*\n${item.dueDate ? `واپسی کا وعدہ: *${item.dueDate}*\n` : ''}\nبرائے مہربانی سہولت کے مطابق ادائیگی فرما دیجیے گا۔ شکریہ!${senderReceiptText()}\n\n✨ *Powered by AZ Flow*`;

      const cleanPhone = (item.phone || "").replace(/[^0-9]/g, "");
      let formattedPhone = cleanPhone;
      if (cleanPhone.startsWith("03")) formattedPhone = "92" + cleanPhone.substring(1);

      const url = formattedPhone
        ? `https://api.whatsapp.com/send?phone=${formattedPhone}&text=${encodeURIComponent(msg)}`
        : `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;

      window.open(url, "_blank");
    }

    function openWhatsAppReceipt(phone, message) {
      let p = String(phone || "").replace(/\D/g, "");
      if (p.startsWith("03")) p = "92" + p.slice(1);
      const url = p ? `https://wa.me/${p}?text=${encodeURIComponent(message)}` : `https://wa.me/?text=${encodeURIComponent(message)}`;
      window.open(url, "_blank");
    }

    function customerReceiptMessage(item) {
      const amount = Number(item.amount) || 0;
      const cost = Number(item.fee) || 0;
      const paid = Number(item.paidAmount ?? item.amount) || 0;
      const balance = Number(item.balanceAmount ?? Math.max(0, amount-paid)) || 0;
      return `🧾 *AZ Flow — کسٹمر رسید*\n━━━━━━━━━━━━━━━━━━\nرسید نمبر: AZ-${item.id}\nکسٹمر: ${item.name || "—"}\nتاریخ: ${item.date || "—"}\n\nکام کی مکمل تفصیل:\n${item.work || "درج نہیں"}\n\nکل فیس: Rs. ${amount.toLocaleString()}\nاب تک وصول: Rs. ${paid.toLocaleString()}\nباقی وصول کرنا ہے: Rs. ${balance.toLocaleString()}\nکام کی لاگت: Rs. ${cost.toLocaleString()}\nخالص بچت/منافع: Rs. ${(Number(item.profit) || amount-cost).toLocaleString()}\n\nکام کی حالت: ${item.status || "جاری ہے"}\nباقی رقم کی تاریخ: ${item.dueDate || "درج نہیں"}\nادائیگی کا طریقہ: ${item.paymentType === "after" ? "کام مکمل ہونے کے بعد" : item.paymentType === "advance" ? "کچھ پہلے، باقی بعد میں" : "مکمل ادائیگی"}\nاضافی تفصیل: ${item.additionalDetails || "درج نہیں"}\n\nشکریہ!\n*Powered by AZ Flow*`;
    }

    function viewCustomerReceipt(id) {
      const item = customerRecords.find(r => r.id === id); if (!item) return;
      const amount = Number(item.amount) || 0, cost = Number(item.fee) || 0;
      const paid = Number(item.paidAmount ?? item.amount) || 0;
      const balance = Number(item.balanceAmount ?? Math.max(0, amount-paid)) || 0;
      document.getElementById("receiptTitle").innerText = "کسٹمر کی ڈیجیٹل رسید";
