                azdText(ctx, ln, xs[c] - cw[c] / 2, cy, { size: 12.5, weight: cell.o.bold ? 800 : 600, color: cell.o.color || C.ink, align: "center", dir: azdIsRtl(ln) ? "rtl" : "ltr" });
