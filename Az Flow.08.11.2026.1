        if (pinCfg && pinH(val, pinCfg.rsalt) === pinCfg.rec) { localStorage.removeItem(PIN_KEY); pinCfg = null; pinOk(); pinClose(); pinUpdateUi(); showToast("PIN ہٹا دیا گیا۔ نیا PIN سیٹ کر سکتے ہیں۔", "🔓"); }
        else { pinRenderDots(); pinShake(); pinMsg("ریکوری کوڈ غلط ہے۔"); }
      }
    }

    function pinFinishSetup() { pinClose(); pinUpdateUi(); showToast("ایپ لاک فعال ہو گیا۔", "🔐"); }
    function pinShowNew() { pinShow("setNew", { title: "نیا PIN درج کریں", sub: "4 ہندسوں کا آسان مگر ذاتی PIN رکھیں", icon: "🔐", extraHtml: pinCancelBtn() }); }
    function pinStartSetup() { pinLoad(); if (pinCfg) { showToast("PIN پہلے سے لگا ہوا ہے۔ بدلنے کے لیے «PIN بدلیں» دبائیں۔", "ℹ️"); return; } pinShowNew(); }
    function pinStartChange() { pinLoad(); if (!pinCfg) return pinShowNew(); pinShow("verifyChange", { title: "موجودہ PIN درج کریں", sub: "PIN بدلنے سے پہلے تصدیق ضروری ہے", icon: "🔑", extraHtml: pinCancelBtn() }); }
    function pinStartRemove() { pinLoad(); if (!pinCfg) return; pinShow("verifyRemove", { title: "PIN ہٹانے کے لیے تصدیق", sub: "موجودہ PIN درج کریں", icon: "🗑️", extraHtml: pinCancelBtn() }); }
    function pinDoRemove() { localStorage.removeItem(PIN_KEY); pinCfg = null; pinClose(); pinUpdateUi(); showToast("PIN ہٹا دیا گیا۔", "🔓"); }
    function pinStartRecover() { pinShow("recover", { len: 8, title: "ریکوری کوڈ درج کریں", sub: "PIN سیٹ کرتے وقت ملنے والا 8 ہندسوں کا کوڈ درج کریں", icon: "🛡️", extraHtml: `<button class="pin-link" type="button" onclick="pinShowUnlock()">واپس</button>` }); }
    function pinLockNow() { pinLoad(); if (!pinCfg) { showToast("پہلے PIN سیٹ کریں۔", "⚠️"); return; } pinShowUnlock(); }

    function pinUpdateUi() {
      pinLoad();
      const on = !!pinCfg, set = (id, show) => { const e = document.getElementById(id); if (e) e.style.display = show ? "" : "none"; };
      set("pinBtnSet", !on); set("pinBtnChange", on); set("pinBtnLockNow", on); set("pinBtnRemove", on);
      const badge = document.getElementById("pinBadge"); if (badge) { badge.textContent = on ? "فعال ✓" : "بند"; badge.classList.toggle("on", on); }
      const t = document.getElementById("pinStatusText");
      if (t) t.textContent = on ? "ایپ لاک فعال ہے۔ ایپ بند کر کے دوبارہ کھولنے یا 1 منٹ پس منظر میں رہنے پر PIN مانگا جائے گا۔" : "اپنے کسٹمر، ادھار اور کاروباری ریکارڈ کو دوسروں کی نظر سے بچانے کے لیے 4 ہندسوں کا PIN لگائیں۔";
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) { pinHiddenAt = Date.now(); return; }
      pinLoad();
      if (pinCfg && pinHiddenAt && Date.now() - pinHiddenAt > 60000 && !document.getElementById("pinLock")?.classList.contains("show")) pinShowUnlock();
      pinHiddenAt = 0;
    });

    // App Initialization
    window.addEventListener("DOMContentLoaded", () => {
      pinLoad(); if (pinCfg) pinShowUnlock(); pinUpdateUi();
      loadAppOwnerProfile();
      loadBusinessData();
      const hd=document.getElementById('householdDate');if(hd)hd.value=localDateInputValue();const pd=document.getElementById('personalExpenseDate');if(pd)pd.value=localDateInputValue();
      loadStorageData();
      renderBusinessModules();
      refreshDashboardMetrics();
      renderRecordsList();
      setTimeout(checkBackupReminder, 2600);
      setTimeout(() => {
        const splash = document.getElementById("splashScreen");
        if (splash) {
          splash.style.opacity = "0";
          setTimeout(() => splash.style.display = "none", 500);
        }
      }, 900);
    });
  </script>
</body>
</html>