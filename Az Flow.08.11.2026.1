      set('householdBudgetView',money(householdMonthlyBudget));set('householdMonthTotal',money(htotal));set('householdRemaining',money(householdMonthlyBudget-htotal));set('householdCount',String(hh.length));set('personalMonthTotal',money(ptotal));set('personalTodayTotal',money(pToday));set('personalCount',String(personalExpenses.length));set('personalDailyAverage',money(ptotal/Math.max(1,now.getDate())));
