    const HOUSEHOLD_CATEGORIES = ["راشن","بجلی / گیس / پانی","کرایہ","تعلیم","صحت","گھر کا سامان","دیگر"];
    const PERSONAL_CATEGORIES = ["کھانا پینا","سفر","ذاتی خریداری","موبائل / انٹرنیٹ","صحت","دیگر"];
    let rfState = null;

    function rfEnsureDom() {
      if (document.getElementById("modalRecordForm")) return;
      const wrap = document.createElement("div");
