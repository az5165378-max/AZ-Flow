              it.lines.forEach((ln, li) => {
                const cy = yy + it.h / 2 + (li - (it.lines.length - 1) / 2) * 26;
                azdText(ctx, ln, M + 16, cy, { size: 14, weight: o.bold === false ? 600 : 800, color: o.color || C.ink, align: "left", dir: azdIsRtl(ln) ? "rtl" : "ltr" });
              });
