    // Analytics Data Calculation
    function refreshAnalyticsData() {
      let totalRev = 0;
      let totalCost = 0;
      let totalProfit = 0;

      customerRecords.forEach(r => {
        totalRev += (r.amount || 0);
        totalCost += (r.fee || 0);
        totalProfit += (r.profit || 0);
      });

      const margin = totalRev > 0 ? ((totalProfit / totalRev) * 100).toFixed(1) : "0";

      document.getElementById("analyticsTotalRev").innerText = "Rs. " + totalRev.toLocaleString();
      document.getElementById("analyticsTotalCost").innerText = "Rs. " + totalCost.toLocaleString();
      document.getElementById("analyticsTotalProfit").innerText = "Rs. " + totalProfit.toLocaleString();
      document.getElementById("analyticsMarginPercent").innerText = margin + "%";

      let rec = 0;
      let pay = 0;
      udhaarRecords.forEach(u => {
        if (!u.settled) {
          if (u.type === "lena") rec += (u.amount || 0);
          else pay += (u.amount || 0);
        }
      });

      document.getElementById("analyticsTotalReceivable").innerText = "Rs. " + rec.toLocaleString();
      document.getElementById("analyticsTotalPayable").innerText = "Rs. " + pay.toLocaleString();
      const net = rec - pay;
      const netEl = document.getElementById("analyticsUdhaarNet");
      netEl.innerText = (net >= 0 ? "+ Rs. " : "- Rs. ") + Math.abs(net).toLocaleString();
      netEl.style.color = net >= 0 ? "#10b981" : "#ef4444";
    }

