    function deletePartnerJob(id){if(!confirm('یہ کام حذف کرنے سے متعلقہ پارٹنرز کے منافع سے اس کام کی تقسیم بھی واپس ہوگی۔ کیا جاری رکھیں؟'))return;const job=partnerJobs.find(j=>j.id===id);if(job){(job.allocations||[]).forEach(a=>{const p=businessPartners.find(x=>x.id===a.partnerId);if(p)p.profit=Number(p.profit||0)-Number(a.amount||0);});}partnerJobs=partnerJobs.filter(j=>j.id!==id);saveBusinessData();renderBusinessModules();}
    function distributePartnerProfit(){
      if(!businessPartners.length){showToast('پہلے پارٹنر شامل کریں۔','⚠️');return;}
      const sum=businessPartners.reduce((a,p)=>a+Number(p.share||0),0);
      if(Math.abs(sum-100)>0.01){showToast('منافع تقسیم کرنے سے پہلے پارٹنرز کے حصے مجموعی طور پر 100% کریں۔','⚠️');return;}
