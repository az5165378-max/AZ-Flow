    // Import Data JSON
    function importDataJson(e) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const parsed = JSON.parse(event.target.result);
          if (!parsed || typeof parsed !== "object" ||
              !Array.isArray(parsed.customers) || !Array.isArray(parsed.udhaar)) {
            throw new Error("Invalid backup structure");
          }
          if (!confirm("بیک اپ لوڈ کرنے سے موجودہ کسٹمر اور ادھار ریکارڈ تبدیل ہو جائیں گے۔ پہلے موجودہ ڈیٹا کا بیک اپ بنا لیں۔ کیا جاری رکھنا ہے؟")) return;
          const oldCustomers = customerRecords;
          const oldUdhaar = udhaarRecords;
          customerRecords = parsed.customers;
          udhaarRecords = parsed.udhaar;
          if (parsed.appOwnerProfile && typeof parsed.appOwnerProfile === "object") {
            appOwnerProfile = { name: String(parsed.appOwnerProfile.name || ""), phone: String(parsed.appOwnerProfile.phone || "") };
            safeWriteStorage(APP_OWNER_PROFILE_KEY, JSON.stringify(appOwnerProfile));
            loadAppOwnerProfile();
          }
          if (Array.isArray(parsed.businessTransactions)) businessTransactions = parsed.businessTransactions;
          if (Array.isArray(parsed.businessPartners)) businessPartners = parsed.businessPartners;
          if (Array.isArray(parsed.partnerJobs)) partnerJobs = parsed.partnerJobs;
          if (Array.isArray(parsed.householdExpenses)) householdExpenses = parsed.householdExpenses;
          if (Array.isArray(parsed.personalExpenses)) personalExpenses = parsed.personalExpenses;
          if (Array.isArray(parsed.businessExpenses)) businessExpenses = parsed.businessExpenses;
          if (parsed.householdMonthlyBudget !== undefined && Number.isFinite(Number(parsed.householdMonthlyBudget))) householdMonthlyBudget = Math.max(0,Number(parsed.householdMonthlyBudget));
          saveBusinessData();
          if (!commitStorageData()) {
            customerRecords = oldCustomers;
            udhaarRecords = oldUdhaar;
            throw new Error("Storage write failed");
          }
          safeWriteStorage("az_flow_initialized_v16", "1");
          refreshDashboardMetrics();
          renderRecordsList();
          renderUdhaarList();
          refreshAnalyticsData();
          showToast("ڈیٹا کامیابی سے ریسٹور ہو گیا!");
        } catch (err) {
          showToast("بیک اپ فائل درست نہیں یا ڈیٹا محفوظ نہیں ہو سکا۔", "❌");
        } finally {
          e.target.value = "";
        }
      };
      reader.readAsText(file);
    }

    // Demo/sample record generation removed: only records added by the user are shown.
    function wipeAllData() {
      if (!confirm("کیا آپ واقعی تمام کسٹمر اور ادھار ریکارڈ مستقل طور پر ڈیلیٹ کرنا چاہتے ہیں؟ یہ عمل واپس نہیں ہو سکے گا۔ پہلے بیک اپ ضرور لے لیں۔")) return;

      // Keep the current storage keys present with empty arrays. Removing them
      // would trigger the legacy migration on the next launch and restore old/demo records.
      const previousCustomers = customerRecords;
      const previousUdhaar = udhaarRecords;
      customerRecords = [];
      udhaarRecords = [];
      businessTransactions = []; businessPartners = []; partnerJobs = []; saveBusinessData();
      const saved = commitStorageData();
      if (!saved) {
        customerRecords = previousCustomers;
        udhaarRecords = previousUdhaar;
        showToast("ڈیٹا محفوظ طور پر صاف نہیں ہو سکا؛ دوبارہ کوشش کریں۔", "❌");
        return;
      }

      // Mark migration as completed and remove legacy copies so they cannot be re-imported.
      safeWriteStorage("az_flow_initialized_v16", "1");
      try {
        localStorage.removeItem("az_flow_permanent_master_records");
        localStorage.removeItem("az_flow_records_v14");
        localStorage.removeItem("az_flow_udhaar_v14");
      } catch (_) {}

      renderRecordsList();
      renderHomeRecentCustomers();
      renderUdhaarList();
      refreshDashboardMetrics();
      refreshAnalyticsData();
      showToast("تمام کسٹمر اور ادھار ریکارڈ مستقل طور پر صاف کر دیے گئے۔", "🗑️");
    }


