    // Safe storage + rendering helpers
    function safeReadStorage(key) {
      try { return localStorage.getItem(key); }
      catch (err) { showToast("اس براؤزر میں ڈیٹا اسٹوریج دستیاب نہیں؛ بیک اپ ضرور رکھیں۔", "⚠️"); return null; }
    }

    function safeWriteStorage(key, value) {
      try { localStorage.setItem(key, value); return true; }
      catch (err) { showToast("ڈیٹا محفوظ نہیں ہو سکا۔ جگہ خالی کریں اور بیک اپ چیک کریں۔", "❌"); return false; }
    }

    function escapeHtml(value) {
      return String(value ?? "").replace(/[&<>"']/g, ch => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      }[ch]));
    }

    function safeCsv(value) {
      let text = String(value ?? "");
      if (/^[\s]*[=+@\-]/.test(text)) text = "'" + text;
      return '"' + text.replace(/"/g, '""') + '"';
    }

    // Toast function
    function showToast(msg, icon = "✅") {
      const toast = document.getElementById("toast");
      toast.innerHTML = `<span class="${icon === "⏳" ? "az-spin" : ""}">${icon}</span> ${msg}`;
      toast.style.display = "none"; void toast.offsetWidth; // restart the entrance animation
      toast.style.display = "block";
      clearTimeout(showToast._t);
      showToast._t = setTimeout(() => { toast.style.display = "none"; }, Math.min(7000, 2800 + String(msg).length * 40));
    }

    // Switch Tabs
    const AZ_SCREENS = ["Home", "Customers", "Shop", "Partner", "Udhaar", "Household", "Personal", "BizExp", "Analytics", "Settings"];
    function switchTab(tab) {
      if (tab === "business") tab = "shop"; // backward-compatible alias
      AZ_SCREENS.forEach(s => {
        const el = document.getElementById("screen" + s);
        const on = s.toLowerCase() === tab;
        if (el) {
          el.style.display = on ? "block" : "none";
          el.classList.remove("enter");
          if (on) { void el.offsetWidth; el.classList.add("enter"); }
        }
        const btn = document.getElementById("tabBtn" + s);
        if (btn) {
          btn.classList.toggle("active", on);
          if (on) { try { btn.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" }); } catch (_) {} }
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (tab === "analytics") refreshAnalyticsData();
      if (tab === "udhaar") renderUdhaarList();
      if (tab === "customers") renderRecordsList();
      if (["shop", "partner", "household", "personal", "bizexp"].includes(tab)) renderBusinessModules();
      if (tab === "settings") pinUpdateUi();
    }

    // Load Data (includes one-time migration from older AZ Flow versions)
    function loadStorageData() {
      try {
        let storedCustomers = safeReadStorage(MASTER_STORAGE_KEY);
        let storedUdhaar = safeReadStorage(UDHAAR_STORAGE_KEY);
        // Only migrate legacy records once, when this app has never been initialized.
        // After a user has used the app or cleared all records, missing keys mean empty data,
        // not permission to resurrect old/demo records from legacy storage.
        const alreadyInitialized = safeReadStorage("az_flow_initialized_v16") === "1";
        if (!alreadyInitialized) {
          if (storedCustomers === null) {
            storedCustomers = safeReadStorage("az_flow_permanent_master_records");
            if (storedCustomers === null) storedCustomers = safeReadStorage("az_flow_records_v14");
          }
          if (storedUdhaar === null) storedUdhaar = safeReadStorage("az_flow_udhaar_v14");
        }

        const parsedCustomers = storedCustomers ? JSON.parse(storedCustomers) : [];
        const parsedUdhaar = storedUdhaar ? JSON.parse(storedUdhaar) : [];
        customerRecords = Array.isArray(parsedCustomers) ? parsedCustomers : [];
        udhaarRecords = Array.isArray(parsedUdhaar) ? parsedUdhaar : [];

        safeWriteStorage(MASTER_STORAGE_KEY, JSON.stringify(customerRecords));
        safeWriteStorage(UDHAAR_STORAGE_KEY, JSON.stringify(udhaarRecords));
        safeWriteStorage("az_flow_initialized_v16", "1");
      } catch (e) {
        customerRecords = [];
        udhaarRecords = [];
        showToast("محفوظ ڈیٹا پڑھنے میں مسئلہ آیا؛ بیک اپ فائل سے ریسٹور کریں۔", "⚠️");
      }
    }

    function commitStorageData() {
      const customersSaved = safeWriteStorage(MASTER_STORAGE_KEY, JSON.stringify(customerRecords));
      const udhaarSaved = safeWriteStorage(UDHAAR_STORAGE_KEY, JSON.stringify(udhaarRecords));
      return customersSaved && udhaarSaved;
    }

    // Dashboard metrics
    function refreshDashboardMetrics() {
      const today = new Date().toLocaleDateString("en-GB");
      const todayLabel = document.getElementById("todayDateLabel");
      if (todayLabel) todayLabel.innerText = today;

      let totalRevenue = 0;
      let totalCost = 0;
      let totalProfit = 0;
      let doneCount = 0;
      let pendingCount = 0;

      customerRecords.forEach(r => {
        totalRevenue += (r.amount || 0);
        totalCost += (r.fee || 0);
        totalProfit += (r.profit || 0);
        if (r.status === "مکمل ہو گیا") doneCount++;
        else pendingCount++;
      });

      document.getElementById("metricTotalRevenue").innerText = "Rs. " + totalRevenue.toLocaleString();
      document.getElementById("metricTotalCost").innerText = "Rs. " + totalCost.toLocaleString();
      document.getElementById("metricTotalProfit").innerText = "Rs. " + totalProfit.toLocaleString();
      document.getElementById("metricCompletedCount").innerText = doneCount;
      document.getElementById("metricPendingCount").innerText = pendingCount;

      // Udhaar Totals
      let receivable = 0;
      let payable = 0;
      udhaarRecords.forEach(u => {
        if (!u.settled) {
          if (u.type === "lena") receivable += (u.amount || 0);
          else payable += (u.amount || 0);
        }
      });
      document.getElementById("homeUdhaarReceivable").innerText = "Rs. " + receivable.toLocaleString();
      document.getElementById("homeUdhaarPayable").innerText = "Rs. " + payable.toLocaleString();

      renderHomeRecentCustomers();
    }

