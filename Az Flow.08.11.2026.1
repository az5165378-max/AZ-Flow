            }
            y = startY + seg + 14; i = j;
          }
        }
        else if (b.type === "table") {
          const cols = b.head.length, tw = W - 2 * M;
          const wr = b.widths || b.head.map(() => 1), sumW = wr.reduce((a, c) => a + c, 0);
          const cw = wr.map(w => tw * w / sumW);
          const xs = []; let acc = W - M; cw.forEach(w => { xs.push(acc); acc -= w; });  // right edge of each column (RTL order)
          const drawHead = () => {
            ctx.fillStyle = C.head; azdRound(ctx, M, y, tw, 36, 10); ctx.fill();
            b.head.forEach((h, c) => azdText(ctx, h, xs[c] - cw[c] / 2, y + 18, { size: 12.5, weight: 800, color: "#fff", align: "center" }));
