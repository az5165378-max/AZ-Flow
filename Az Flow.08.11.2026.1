      document.getElementById('partnerList').innerHTML=businessPartners.length?businessPartners.map(p=>`<div class="card"><div class="receipt-row"><b>${escapeHtml(p.name)}</b><span class="val">${p.share}% حصہ</span></div><div class="receipt-row"><span>سرمایہ</span><span class="val">${money(p.capital)}</span></div><div class="receipt-row"><span>درج شدہ منافع</span><span class="val">${money(p.profit)}</span></div><div class="record-actions">${azBtns('partner',p.id,'partner')}<button class="btn btn-danger" onclick="deletePartner('${p.id}')">پارٹنر حذف کریں</button></div></div>`).join(''):'<div class="card" style="color:var(--muted)">ابھی پارٹنر شامل نہیں کیا گیا۔</div>';
      document.getElementById('partnerJobList').innerHTML=partnerJobs.length?partnerJobs.map(j=>`<div class=\"card\"><div class=\"receipt-row\"><b>${escapeHtml(j.detail)}</b><span class=\"val\">${money(j.profit)}</span></div><div class=\"receipt-row\"><span>کام درج کرنے والا</span><span class=\"val\">${escapeHtml(j.partnerName)}</span></div><div class=\"receipt-row\"><span>فیس / فروخت</span><span class=\"val\">${money(j.fee)}</span></div><div class=\"receipt-row\"><span>لاگت</span><span class=\"val\">${money(j.cost)}</span></div><div class=\"receipt-row bold\"><span>خالص منافع</span><span class=\"val\">${money(j.profit)}</span></div><div style=\"font-size:12px;line-height:1.8\">${(j.allocations||[]).map(a=>`${escapeHtml(a.name)} (${a.share}%): ${money(a.amount)}`).join('<br>')}</div><div style=\"font-size:10px;color:var(--muted)\">${new Date(j.date).toLocaleString()}</div><div class=\"record-actions\">${azBtns('job',j.id,'job')}<button class=\"btn btn-danger\" style=\"margin-top:8px\" onclick=\"deletePartnerJob('${j.id}')\">کام حذف کریں</button></div></div>`).join(''):'<div class=\"card\" style=\"color:var(--muted)\">ابھی کوئی پارٹنرشپ کام درج نہیں۔</div>' ;
      document.getElementById('businessTxnList').innerHTML=businessTransactions.length?businessTransactions.map(t=>`<div class="card"><div class="receipt-row"><b>${t.type==='purchase'?'📦 خریداری':'🛒 فروخت'}: ${escapeHtml(t.name)}</b><span class="val">${money(t.total)}</span></div><div class="receipt-row"><span>مقدار × فی یونٹ</span><span class="val">${t.qty} × ${money(t.unit)}</span></div>${t.type==='sale'?`<div class="receipt-row"><span>درج شدہ منافع</span><span class="val">${money(t.profit)}</span></div>`:''}<div style="font-size:10px;color:var(--muted)">${new Date(t.date).toLocaleString()}</div><div class="record-actions">${azBtns(t.type,t.id,t.type)}<button class="btn btn-danger" onclick="deleteBusinessTxn('${t.id}')">لین دین حذف کریں</button></div></div>`).join(''):'<div class="card" style="color:var(--muted)">ابھی کوئی خریداری یا فروخت درج نہیں۔</div>';
    }

    // Export Data as JSON
