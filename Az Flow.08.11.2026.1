    function onPaymentTypeChange() {
      const t = document.getElementById("inputPaymentType").value, paidEl = document.getElementById("inputPaidAmount");
      if (t === "advance") paidEl.value = "";   // let the user type the advance
      updatePaymentFields();
      if (t === "advance") setTimeout(() => { try { paidEl.focus(); } catch (_) {} }, 60);
    }
    function updatePaymentFields() {
      const total = Math.max(0, parseFloat(document.getElementById("inputAmount").value) || 0);
      const type = document.getElementById("inputPaymentType").value;
      const paidEl = document.getElementById("inputPaidAmount"), dueEl = document.getElementById("inputDueDate");
      if (type === "full") paidEl.value = total;
      else if (type === "after") paidEl.value = 0;
      const paid = Math.max(0, Math.min(total, parseFloat(paidEl.value) || 0)), bal = Math.max(0, total - paid);
      paidEl.readOnly = type !== "advance"; paidEl.classList.toggle("az-locked", type !== "advance");
      // automatic form: only show the fields that make sense for the chosen payment method
      const showPaid = type !== "after", showDue = bal > 0 && type !== "full";
      const gp = document.getElementById("grpPaid"), gd = document.getElementById("grpDue"), row = document.getElementById("rowPayExtra");
      const toggle = (el, on) => { if (!el) return; const was = el.style.display !== "none"; el.style.display = on ? "" : "none"; if (on && !was) { el.classList.remove("az-appear"); void el.offsetWidth; el.classList.add("az-appear"); } };
      toggle(gp, showPaid); toggle(gd, showDue); toggle(row, showPaid || showDue);
      if (row) row.classList.toggle("single", !(showPaid && showDue));
      if (!showDue && dueEl) dueEl.value = "";
      const lbl = document.getElementById("lblDue"); if (lbl) lbl.textContent = type === "after" ? "ادائیگی کی متوقع تاریخ" : "باقی رقم کی متوقع تاریخ";
      document.getElementById("paidPreview").innerText = "Rs. " + paid.toLocaleString();
      document.getElementById("balancePreview").innerText = "Rs. " + bal.toLocaleString();
      const status = document.getElementById("inputStatus").value;
      const hints = {
        full: "مکمل ادائیگی درج ہے؛ باقی رقم صفر ہوگی۔",
        advance: "ایڈوانس رقم درج کریں؛ باقی رقم خودکار طور پر نکالی جائے گی۔",
        after: status === "مکمل ہو گیا" ? "کام مکمل ہے؛ اب باقی رقم وصول کرنا ہے۔ وصول شدہ رقم اوپر اپڈیٹ کریں۔" : "کام مکمل ہونے کے بعد ادائیگی متوقع ہے؛ فی الحال وصول رقم صفر رہے گی۔"
      };
      document.getElementById("paymentHint").innerText = hints[type];
    }

    function submitCustomerForm() {
      const name = document.getElementById("inputName").value.trim();
      const phone1 = document.getElementById("inputPhone1").value.trim();
      const phone2 = document.getElementById("inputPhone2").value.trim();
      const phone3 = document.getElementById("inputPhone3").value.trim();
      const work = document.getElementById("inputWork").value.trim();
      const amount = parseFloat(document.getElementById("inputAmount").value) || 0;
      const fee = parseFloat(document.getElementById("inputFee").value) || 0;
      const status = document.getElementById("inputStatus").value;
      const paymentType = document.getElementById("inputPaymentType").value;
      const additionalDetails = document.getElementById("inputAdditionalDetails").value.trim();
      const dueDate = document.getElementById("inputDueDate").value;
      const paidAmount = Math.max(0, Math.min(amount, parseFloat(document.getElementById("inputPaidAmount").value) || 0));
      const balanceAmount = Math.max(0, amount - paidAmount);

      if (!name) {
        showToast("براہ کرم گاہک کا نام درج کریں!", "⚠️");
        return;
      }
      if (amount <= 0) {
        showToast("براہ کرم وصولی کی درست رقم درج کریں!", "⚠️");
        return;
      }

      const profit = amount - fee;
      const todayStr = new Date().toLocaleDateString("en-GB");

      if (activeEditingId) {
        const idx = customerRecords.findIndex(r => r.id === activeEditingId);
        if (idx !== -1) {
          customerRecords[idx] = {
            ...customerRecords[idx],
            name, phone1, phone2, phone3, work, amount, fee, profit, status,
            paymentType, paidAmount, balanceAmount, dueDate, additionalDetails,
            updatedAt: Date.now()
          };
          showToast("کسٹمر ریکارڈ اپڈیٹ ہو گیا!");
        }
      } else {
        const newRecord = {
          id: Date.now(),
          name, phone1, phone2, phone3, work, amount, fee, profit, status,
          paymentType, paidAmount, balanceAmount, dueDate, additionalDetails,
          date: todayStr,
          createdAt: Date.now()
        };
        customerRecords.unshift(newRecord);
        showToast("نیا کسٹمر کامیابی سے شامل ہو گیا!");
      }

      commitStorageData();
      closeCustomerModal();
      refreshDashboardMetrics();
      renderRecordsList();
    }

