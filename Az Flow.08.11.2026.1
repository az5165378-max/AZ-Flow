    function rfSpec(kind, rec) {
      const isEdit = !!rec;
      const T = (a, b) => isEdit ? a : b;
      if (kind === "purchase" || kind === "sale") {
        const sale = kind === "sale";
        const fields = [
          { key: "name", label: sale ? "فروخت کیے گئے سامان کا نام *" : "خریدے گئے سامان کا نام *", type: "text", value: rec?.name || "" },
          { key: "qty", label: "مقدار *", type: "number", step: "any", value: rec?.qty ?? 1 },
          { key: "unit", label: sale ? "فی یونٹ فروخت قیمت (روپے) *" : "فی یونٹ خریداری قیمت (روپے) *", type: "number", step: "any", value: rec?.unit ?? "" }
        ];
        if (sale) fields.push({ key: "cost", label: "فی یونٹ خریداری لاگت (منافع کے حساب کے لیے) *", type: "number", step: "any", value: rec?.cost ?? 0 });
        fields.push({ key: "date", label: "تاریخ", type: "date", value: rec?.date ? localDateInputValue(new Date(rec.date)) : localDateInputValue() });
        return { title: sale ? T("فروخت میں ترمیم", "نئی فروخت درج کریں") : T("خریداری میں ترمیم", "نئی خریداری درج کریں"), fields, preview: true,
          help: isEdit ? "ترمیم کے بعد کل رقم، منافع اور اسٹاک خودکار دوبارہ حساب ہو جائیں گے۔" : "" };
      }
      if (kind === "partner") {
        return { title: T("پارٹنر میں ترمیم", "نیا پارٹنر شامل کریں"), fields: [
          { key: "name", label: "پارٹنر کا نام *", type: "text", value: rec?.name || "" },
          { key: "capital", label: "سرمایہ (روپے)", type: "number", step: "any", value: rec?.capital ?? 0 },
          { key: "share", label: "منافع کا حصہ (فیصد) *", type: "number", step: "any", value: rec?.share ?? "" }
        ], help: isEdit ? "نام تبدیل کرنے سے پرانے کاموں میں بھی نام اپڈیٹ ہو جائے گا۔ حصے کی تبدیلی صرف آئندہ درج ہونے والے کاموں پر لاگو ہوگی؛ پرانی تقسیم وہی رہے گی۔" : "" };
      }
      if (kind === "job") {
        return { title: T("پارٹنرشپ کام میں ترمیم", "پارٹنرشپ کا نیا کام درج کریں"), fields: [
