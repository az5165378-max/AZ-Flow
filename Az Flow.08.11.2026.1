    }

    // ---- minimal PDF writer: one JPEG page image per A4 page ----
    function azdPdfBlob(pages) {
      const enc = new TextEncoder(), parts = [], offs = []; let len = 0;
      const push = u => { parts.push(u); len += u.length; };
      const str = t => push(enc.encode(t));
      const PW = 595.28, PH = 841.89, n = pages.length;
      str("%PDF-1.4\n");
      offs[1] = len; str("1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n");
      offs[2] = len; str("2 0 obj\n<< /Type /Pages /Kids [" + pages.map((_, i) => (3 + i * 3) + " 0 R").join(" ") + "] /Count " + n + " >>\nendobj\n");
      pages.forEach((cv, i) => {
        const pObj = 3 + i * 3, cObj = pObj + 1, iObj = pObj + 2;
        const b64 = cv.toDataURL("image/jpeg", 0.92).split(",")[1], bin = atob(b64), img = new Uint8Array(bin.length);
        for (let k = 0; k < bin.length; k++) img[k] = bin.charCodeAt(k);
        offs[pObj] = len; str(pObj + " 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 " + PW + " " + PH + "] /Resources << /XObject << /Im0 " + iObj + " 0 R >> >> /Contents " + cObj + " 0 R >>\nendobj\n");
        const content = "q " + PW + " 0 0 " + PH + " 0 0 cm /Im0 Do Q";
        offs[cObj] = len; str(cObj + " 0 obj\n<< /Length " + content.length + " >>\nstream\n" + content + "\nendstream\nendobj\n");
        offs[iObj] = len; str(iObj + " 0 obj\n<< /Type /XObject /Subtype /Image /Width " + cv.width + " /Height " + cv.height + " /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length " + img.length + " >>\nstream\n");
        push(img); str("\nendstream\nendobj\n");
      });
      const total = 3 + n * 3, xref = len;
      str("xref\n0 " + total + "\n0000000000 65535 f \n");
      for (let i = 1; i < total; i++) str(String(offs[i]).padStart(10, "0") + " 00000 n \n");
      str("trailer\n<< /Size " + total + " /Root 1 0 R >>\nstartxref\n" + xref + "\n%%EOF");
      return new Blob(parts, { type: "application/pdf" });
    }

    function azdPngBlob(pages) {
      return new Promise(res => {
        if (pages.length === 1) return pages[0].toBlob(res, "image/png");
        const big = document.createElement("canvas"); big.width = pages[0].width; big.height = pages[0].height * pages.length;
        const c = big.getContext("2d"); pages.forEach((p, i) => c.drawImage(p, 0, i * p.height)); big.toBlob(res, "image/png");
      });
    }

    function azdSave(blob, name) {
      const url = URL.createObjectURL(blob), a = document.createElement("a");
      a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 4000);
    }

    // ---- viewer ----
    function azdEnsureModal() {
      if (document.getElementById("modalDoc")) return;
      const m = document.createElement("div"); m.id = "modalDoc"; m.className = "modal-overlay az-doc-overlay";
      m.setAttribute("role", "dialog"); m.setAttribute("aria-modal", "true");
      m.innerHTML = `<div class="az-doc-box">
        <div class="az-doc-head"><h3 id="azdTitle"></h3><button class="close-btn" type="button" aria-label="بند کریں" onclick="azdClose()">&times;</button></div>
        <div class="az-doc-pages" id="azdPages"></div>
        <div class="az-doc-actions">
          <button class="btn btn-success" type="button" onclick="azdDownloadPdf()">📄 PDF ڈاؤنلوڈ</button>
          <button class="btn btn-whatsapp" type="button" onclick="azdWhatsApp()">🟢 WhatsApp</button>
          <button class="btn btn-primary" type="button" onclick="azdDownloadPng()">🖼️ تصویر (PNG)</button>
        </div></div>`;
      m.addEventListener("mousedown", e => { if (e.target === m) azdClose(); });
      document.body.appendChild(m);
    }
    function azdClose() { const m = document.getElementById("modalDoc"); if (m) m.style.display = "none"; azdLast = null; }

    async function azdOpen(spec, meta = {}) {
      azdEnsureModal(); showToast("دستاویز تیار ہو رہی ہے…", "⏳");
      let pages;
      try { pages = await azdRender(spec); } catch (e) { showToast("دستاویز نہیں بن سکی؛ دوبارہ کوشش کریں۔", "❌"); return; }
      azdLast = { spec, pages, meta, file: meta.file || ("AZ-Flow-" + Date.now()) };
      document.getElementById("azdTitle").textContent = spec.title;
      document.getElementById("azdPages").innerHTML = pages.map((p, i) => `<img alt="صفحہ ${i + 1}" src="${p.toDataURL("image/jpeg", 0.85)}">`).join("");
      document.getElementById("modalDoc").style.display = "flex";
      document.getElementById("azdPages").scrollTop = 0;
    }

    async function azdShareOrSave(kind) {
      if (!azdLast) return;
      const isPdf = kind === "pdf";
      const blob = isPdf ? azdPdfBlob(azdLast.pages) : await azdPngBlob(azdLast.pages);
      const name = azdLast.file + (isPdf ? ".pdf" : ".png");
      return { blob, name };
    }
    async function azdDownloadPdf() { const f = await azdShareOrSave("pdf"); if (!f) return; azdSave(f.blob, f.name); showToast("PDF ڈاؤنلوڈ ہو گئی ✓", "📄"); }
    async function azdDownloadPng() { const f = await azdShareOrSave("png"); if (!f) return; azdSave(f.blob, f.name); showToast("تصویر محفوظ ہو گئی ✓", "🖼️"); }
    async function azdWhatsApp() {
      if (!azdLast) return;
      const f = await azdShareOrSave("pdf"), meta = azdLast.meta;
      const file = new File([f.blob], f.name, { type: "application/pdf" });
      const text = azdSummaryText(azdLast.spec);
      try {
        if (navigator.canShare && navigator.canShare({ files: [file] })) { await navigator.share({ files: [file], title: azdLast.spec.title, text }); return; }
      } catch (e) { if (e && e.name === "AbortError") return; }
      azdSave(f.blob, f.name); showToast("PDF محفوظ ہو گئی؛ WhatsApp میں اٹیچ کر کے بھیجیں۔", "📎");
      setTimeout(() => openWhatsAppReceipt(meta.phone || "", text), 600);
    }
    function azdSummaryText(spec) {
      let t = "🧾 *AZ Flow — " + spec.title + "*\n━━━━━━━━━━━━━━━━━━";
      (spec.blocks || []).forEach(b => { if (b.type === "kv") b.rows.forEach(r => { if (r && r[1] !== undefined && String(r[1]) !== "") t += "\n" + r[0] + ": " + String(r[1]).replace(/[\u2066\u2069]/g, ""); }); if (b.type === "total") t += "\n*" + b.label + ": " + String(b.value).replace(/[\u2066\u2069]/g, "") + "*"; });
      return t + senderReceiptText() + "\n\n✨ *Powered by Ansar AZ*";
    }

    // =========================== document builders ===========================
    const azdKindName = { customer: "کسٹمر", udhaar: "ادھار", purchase: "خریداری", sale: "فروخت", partner: "پارٹنر", job: "پارٹنرشپ کام", household: "گھریلو خرچہ", personal: "ذاتی خرچہ", bizexp: "کاروباری خرچہ" };
    const sameText = (a, b) => String(a || "").trim().toLowerCase() === String(b || "").trim().toLowerCase();
    const cleanPhone = p => String(p || "").replace(/\D/g, "");
    const azdClean = v => { const t = String(v == null ? "" : v).trim(); return /^(none|null|undefined|nil|n\/a|na|-|—)$/i.test(t) ? "" : t; };
    const azdPhones = r => [r.phone1, r.phone2, r.phone3].map(azdClean).filter(Boolean).join(" ، ");
    const azdPayLabel = t => ({ full: "مکمل رقم پہلے ہی ادا", advance: "کچھ رقم پہلے، باقی بعد میں", after: "کام مکمل ہونے کے بعد ادائیگی" })[azdClean(t)] || azdClean(t);

    function azdBuildReceipt(kind, id) {
      const sid = String(id);
      if (kind === "customer") {
        const r = customerRecords.find(x => String(x.id) === sid); if (!r) return null;
        const amount = Number(r.amount) || 0, paid = Number(r.paidAmount ?? r.amount) || 0, bal = Number(r.balanceAmount ?? Math.max(0, amount - paid)) || 0;
        const done = r.status === "مکمل ہو گیا";
        return { spec: { title: "ادائیگی کی رسید", docNo: "AZ-" + r.id, date: azdDate(r.date), blocks: [
          { type: "section", text: "کسٹمر کی تفصیل" },
          { type: "kv", rows: [["کسٹمر کا نام", r.name], ["موبائل", azdPhones(r)], ["رسید کی تاریخ", azdDate(r.date)], ["کام / سروس", r.work || "عام سروس"], ["ادائیگی کا طریقہ", azdPayLabel(r.paymentType)], ["حالت", r.status], ["اگلی ادائیگی کی تاریخ", (r.dueDate && bal > 0 && r.paymentType !== "full") ? azdDate(r.dueDate) : ""], ["اضافی تفصیل", azdClean(r.additionalDetails)]] },
          { type: "section", text: "حساب کی صورتحال" },
          { type: "summary", items: [{ label: "کل رقم", value: azdMoney(amount), color: AZD.C.accent }, { label: "وصول شدہ", value: azdMoney(paid), color: AZD.C.good }, { label: "باقی", value: azdMoney(bal), color: bal > 0 ? AZD.C.warn : AZD.C.good }] },
          { type: "badge", text: bal > 0 ? "⏳ بقایا رقم باقی ہے" : "✅ ادائیگی مکمل", bg: bal > 0 ? "#fef3c7" : "#dcfce7", color: bal > 0 ? "#b45309" : AZD.C.good },
          { type: "total", label: bal > 0 ? "واجب الادا بقایا رقم" : "کل وصول شدہ رقم", value: azdMoney(bal > 0 ? bal : paid), color: bal > 0 ? AZD.C.warn : AZD.C.good },
          { type: "note", text: "یہ کمپیوٹر سے تیار کردہ رسید ہے۔ ادائیگی کا ریکارڈ AZ Flow میں محفوظ ہے۔" }, { type: "sign" }] }, meta: { phone: r.phone1, file: "AZ-Flow-Receipt-" + r.id } };
      }
