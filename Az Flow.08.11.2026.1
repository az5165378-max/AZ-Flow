  <!-- AZ Flow 0.1: existing storage keys retained to preserve user data -->
  <!-- JAVASCRIPT LOGIC -->
  <script>
    // ===== Motion preference (default ON; independent from the phone's animation setting) =====
    (function () { try { if (localStorage.getItem("az_flow_motion_v1") === "off") document.documentElement.classList.add("az-reduce"); } catch (_) {} })();

    // ===== Urdu font style (sans / naskh) + report of the font actually in use =====
    (function () { try { if (localStorage.getItem("az_flow_font_v1") === "naskh") document.documentElement.classList.add("az-font-naskh"); } catch (_) {} })();
    function azActiveFont() {
      try {
        const c = document.createElement("canvas").getContext("2d"), T = "اردو کھاتہ ہے ۓ ٹڈڑ";
        const w = f => { c.font = "20px " + f; return c.measureText(T).width; };
        const base = w("'AZ Urdu'");
        const order = document.documentElement.classList.contains("az-font-naskh") ? ["Noto Naskh Arabic", "Noto Sans Arabic"] : ["Noto Sans Arabic", "Noto Naskh Arabic"];
        for (const n of order) if (Math.abs(w("'" + n + "','AZ Urdu'") - base) > 0.01) return n;
        return "AZ Urdu (ایپ میں شامل)";
      } catch (_) { return "—"; }
    }
    function azFontRefresh() {
      const naskh = document.documentElement.classList.contains("az-font-naskh");
      const b = document.getElementById("fontBadge"); if (b) b.textContent = naskh ? "نسخ" : "صاف سانس";
      const l = document.getElementById("fontActiveLine"); if (l) l.textContent = "فعال فونٹ: " + azActiveFont();
    }
    function azFontSet(kind) {
      document.documentElement.classList.toggle("az-font-naskh", kind === "naskh");
      try { localStorage.setItem("az_flow_font_v1", kind); } catch (_) {}
      setTimeout(azFontRefresh, 400); showToast(kind === "naskh" ? "نسخ انداز لگ گیا" : "صاف سانس انداز لگ گیا", "🔤");
    }
    window.addEventListener("load", () => { (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(() => setTimeout(azFontRefresh, 600)); });

    // Delete hint: the card shakes red when its delete button is tapped
    document.addEventListener("click", e => {
      const b = e.target.closest && e.target.closest("button"); if (!b) return;
      const oc = (b.getAttribute("onclick") || "") + b.textContent;
      if (!/delet|حذف|🗑/i.test(oc)) return;
      const card = b.closest(".item-card,.card,.expense-record"); if (!card) return;
      card.classList.add("az-del-hint"); setTimeout(() => card.classList.remove("az-del-hint"), 900);
    }, true);

    // ===== Performance governor: pause loops while scrolling, auto "lite" mode on slow phones =====
    (function () {
      const H = document.documentElement, KEY = "az_flow_perf_v1";
      try { if (localStorage.getItem(KEY) === "lite" || (navigator.deviceMemory && navigator.deviceMemory <= 2)) H.classList.add("az-lite"); } catch (_) {}
      let t; window.addEventListener("scroll", () => { H.classList.add("az-scrolling"); clearTimeout(t); t = setTimeout(() => H.classList.remove("az-scrolling"), 180); }, { passive: true });
      setTimeout(() => {
        if (H.classList.contains("az-lite")) return;
        let n = 0; const t0 = performance.now();
        (function f(now) { n++; if (now - t0 < 2000) requestAnimationFrame(f); else if (n / ((now - t0) / 1000) < 46) { H.classList.add("az-lite"); try { localStorage.setItem(KEY, "lite"); } catch (_) {} } })(t0);
      }, 3200);
    })();

    // Wrap a leading emoji in titles so animated gradient text never washes out its colours
    function azWrapTitleEmoji() {
      try {
        const RX = /^(\p{Extended_Pictographic}\uFE0F?)\s*/u;
        document.querySelectorAll(".screen-content>.card-title>span:first-child,.card .card-title>span:first-child").forEach(el => {
          if (el.dataset.emo || el.children.length) return; el.dataset.emo = "1";
          const full = el.textContent || "", m = RX.exec(full), rest = m ? full.slice(m[0].length) : full;
          el.textContent = "";
          if (m) { const e = document.createElement("span"); e.className = "az-emo"; e.textContent = m[1]; el.appendChild(e); el.appendChild(document.createTextNode(" ")); }
          const t = document.createElement("span"); t.className = "az-txt"; t.textContent = rest; el.appendChild(t);
        });
      } catch (_) {}
    }
    window.addEventListener("DOMContentLoaded", azWrapTitleEmoji);

    // Pause infinite decorative animations on elements that are off screen
    (function () {
      if (!("IntersectionObserver" in window)) return;
      const io = new IntersectionObserver(es => es.forEach(e => e.target.classList.toggle("az-off", !e.isIntersecting)), { rootMargin: "60px" });
      const SEL = ".screen-content .card,.qtile,.metric-box,.mini-box,.welcome-card,.guide-item,.guide-hero";
