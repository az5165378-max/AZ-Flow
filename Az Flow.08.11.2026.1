    function deletePartner(id){if(!confirm('کیا اس پارٹنر کا ریکارڈ حذف کرنا ہے؟'))return;businessPartners=businessPartners.filter(p=>p.id!==id);saveBusinessData();renderBusinessModules();}
    function localDateInputValue(d=new Date()){const z=new Date(d.getTime()-d.getTimezoneOffset()*60000);return z.toISOString().slice(0,10);}
    function saveHouseholdBudget(){const el=document.getElementById('householdBudget');const v=Number(el?.value||0);if(!Number.isFinite(v)||v<0){showToast('درست ماہانہ بجٹ درج کریں۔','⚠️');return;}householdMonthlyBudget=v;safeWriteStorage(HOUSEHOLD_BUDGET_KEY,String(v));renderExpenseModules();showToast('ماہانہ گھریلو بجٹ محفوظ ہوگیا۔');}
    function addExpenseRecord(kind){
      const household=kind==='household';
