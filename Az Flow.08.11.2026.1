      render(hh,'household','householdExpenseList');render(pp,'personal','personalExpenseList');
      { const bb=businessExpenses.filter(x=>String(x.date||'').slice(0,7)===month); render(businessExpenses,'bizexp','bizExpList');
        set('bizTodayTotal',money(sum(businessExpenses.filter(x=>x.date===today))));set('bizMonthTotal',money(sum(bb)));set('bizAllTotal',money(sum(businessExpenses)));set('bizCount',String(businessExpenses.length));set('metricBizExpMonth',money(sum(bb)));
        const bd=document.getElementById('bizDate');if(bd&&!bd.value)bd.value=today; }
    }
