          { type: "section", text: "کھاتے کی تفصیل" },
          { type: "kv", rows: [["شخص / پارٹی", u.personName], ["موبائل", azdClean(u.phone)], ["کھاتے کی قسم", lena ? "رقم وصول کرنی ہے (لینا ہے)" : "رقم ادا کرنی ہے (دینا ہے)", { color: lena ? AZD.C.good : AZD.C.bad }], ["درج تاریخ", azdDate(u.date)], ["مد / تفصیل", azdClean(u.details)], ["واپسی کا وعدہ", (u.dueDate && !u.settled) ? azdDate(u.dueDate) : ""], ["اضافی تفصیل / شرائط", azdClean(u.additionalDetails)], ["حالت", u.settled ? "ادائیگی مکمل" : "بقایا"]] },
          { type: "total", label: lena ? "وصول کرنے والی رقم" : "ادا کرنے والی رقم", value: azdMoney(u.amount), color: lena ? AZD.C.good : AZD.C.bad },
          { type: "badge", text: u.settled ? "✅ ادائیگی مکمل ہو چکی ہے" : "⏳ ادائیگی باقی ہے", bg: u.settled ? "#dcfce7" : "#fef3c7", color: u.settled ? AZD.C.good : "#b45309" },
          { type: "sign" }] }, meta: { phone: u.phone, file: "AZ-Flow-Udhaar-" + u.id } };
      }
      if (kind === "purchase" || kind === "sale") {
        const t = businessTransactions.find(x => String(x.id) === sid); if (!t) return null; const sale = t.type === "sale";
