      <a href="https://chat.whatsapp.com/ESePIIyZUJKAtvm8WJE6Yf?s=cl&p=a&mlu=4&ilr=4&iam=2" target="_blank" rel="noopener noreferrer" style="text-decoration:none; display:flex; align-items:center; justify-content:space-between; background:#dcfce7; border:1px solid #86efac; border-radius:var(--radius-md); padding:10px 14px; margin-bottom:10px; box-shadow:0 2px 6px rgba(22,163,74,.12); transition:transform .15s ease;">
