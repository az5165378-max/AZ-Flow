      const shareSum=businessPartners.reduce((a,p)=>a+Number(p.share||0),0);
      if(Math.abs(shareSum-100)>0.01){showToast('پہلے تمام پارٹنرز کے منافع کے حصے ملا کر 100% کریں۔','⚠️');return;}
