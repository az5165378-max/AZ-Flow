    // PNG receipt export: save locally first; on supported Android browsers share the actual image file.
    async function saveReceiptPNG(shareAfter=false){
      const el=document.getElementById('printReceipt'); if(!el){showToast('پہلے رسید کھولیں۔','⚠️');return;}
      try{
        if(typeof window.html2canvas==='undefined'){
          await new Promise((resolve,reject)=>{const sc=document.createElement('script');sc.src='https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';sc.onload=resolve;sc.onerror=reject;document.head.appendChild(sc);});
        }
        const canvas=await window.html2canvas(el,{backgroundColor:'#ffffff',scale:2,useCORS:true,logging:false});
        const blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/png'));
        if(!blob) throw new Error('PNG');
        const filename='AZ-Flow-Receipt-'+Date.now()+'.png';
        const file=new File([blob],filename,{type:'image/png'});
        if(shareAfter && navigator.share && (!navigator.canShare || navigator.canShare({files:[file]}))){
          await navigator.share({files:[file],title:'AZ Flow رسید',text:'AZ Flow کی رسید'}); return;
        }
        const url=URL.createObjectURL(blob); const a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),3000);
        showToast('PNG رسید محفوظ ہوگئی؛ اب WhatsApp میں اٹیچمنٹ کے طور پر بھیجیں۔');
      }catch(e){showToast('PNG بنانے کے لیے انٹرنیٹ/براؤزر اجازت درکار ہو سکتی ہے؛ PDF/پرنٹ والا آپشن استعمال کریں۔','⚠️');}
    }
    function openReceiptWhatsAppWithImage(phone,message){
      const doShare=async()=>{try{await saveReceiptPNG(true);}catch(e){} if(phone || message) openWhatsAppReceipt(phone,message);};
      // Try native image sharing. If unsupported, the PNG is downloaded and user can attach it in WhatsApp.
      saveReceiptPNG(true).then(()=>{}).catch(()=>{});
      if(message) setTimeout(()=>openWhatsAppReceipt(phone,message),500);
    }
