 radial-gradient(ellipse at 95% 28%,rgba(99,102,241,.10),transparent 30%),
 linear-gradient(145deg,#eef6ff 0%,#f7f9ff 48%,#eaf2fb 100%);
 background-attachment:fixed;
}
.top-bar{
 background:linear-gradient(135deg,#031027 0%,#082b55 48%,#075985 100%);
 box-shadow:0 12px 30px rgba(2,20,48,.30),inset 0 -1px rgba(255,255,255,.16);
 border-bottom:1px solid rgba(125,211,252,.28);
}
.brand-icon{
 background:linear-gradient(145deg,#e0f2fe 0%,#38bdf8 38%,#075985 100%);
 border:1px solid rgba(255,255,255,.65);
 box-shadow:0 8px 18px rgba(14,165,233,.38),inset 0 2px 5px rgba(255,255,255,.8),inset 0 -5px 9px rgba(3,37,65,.25);
 transform:translateZ(0);
}
.app-container{padding-top:20px;padding-bottom:26px}
.card,.module-tile,.quick-module,.stat-box,.summary-box,.record-card,.expense-card{
 border:1px solid rgba(255,255,255,.88)!important;
 border-radius:22px!important;
 background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(239,247,255,.94))!important;
 box-shadow:0 13px 26px rgba(24,57,99,.09),0 3px 7px rgba(24,57,99,.05),inset 0 1px 0 #fff,inset 0 -1px 0 rgba(148,163,184,.12)!important;
}
.card{position:relative;overflow:hidden;transition:transform .22s ease,box-shadow .22s ease}
.card:before{
 content:"";position:absolute;inset:0 0 auto;height:4px;
 background:linear-gradient(90deg,#38bdf8,#6366f1,#a78bfa,#fbbf24);
 opacity:.85
}
.card:active,.module-tile:active,.quick-module:active{transform:translateY(2px) scale(.985)}
.card-title{color:#0b3158}
button,.btn,.icon-btn,.nav-item{
 transition:transform .2s ease,box-shadow .2s ease,filter .2s ease,background .2s ease!important
}
.btn-primary,.btn-success,.btn-danger,.btn-warning{
 border:1px solid rgba(255,255,255,.42)!important;
 box-shadow:0 7px 15px rgba(2,132,199,.20),inset 0 1px 0 rgba(255,255,255,.38)!important;
}
.btn-primary{background:linear-gradient(135deg,#0284c7,#075985)!important}
button:active,.btn:active{transform:translateY(2px) scale(.98);filter:brightness(.97)}
input,select,textarea{
 border:1px solid #cbdced!important;border-radius:14px!important;
 background:linear-gradient(180deg,#fff,#f5f9ff)!important;
 box-shadow:inset 0 2px 5px rgba(20,50,90,.045),0 2px 5px rgba(20,50,90,.035)!important;
 transition:border-color .2s,box-shadow .2s!important
}
input:focus,select:focus,textarea:focus{
 outline:none!important;border-color:#38bdf8!important;
 box-shadow:0 0 0 3px rgba(56,189,248,.16),inset 0 2px 5px rgba(20,50,90,.04)!important
}
.bottom-nav{
 background:linear-gradient(180deg,rgba(255,255,255,.96),rgba(232,243,255,.98))!important;
 border-top:1px solid rgba(255,255,255,.95)!important;
 box-shadow:0 -10px 28px rgba(15,35,70,.13),inset 0 1px 0 #fff!important;
 backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)
}
.nav-item{border-radius:15px!important}
.nav-item.active{
 color:#0369a1!important;background:linear-gradient(145deg,#e0f2fe,#bfdbfe)!important;
 box-shadow:0 5px 12px rgba(2,132,199,.16),inset 0 1px 0 #fff!important
}
.module-tile,.quick-module{
 position:relative;overflow:hidden;transform:translateZ(0);
 box-shadow:0 12px 24px rgba(30,64,110,.13),inset 0 1px 0 rgba(255,255,255,.9)!important
}
.module-tile:after,.quick-module:after{
 content:"";position:absolute;width:100px;height:100px;border-radius:50%;
 top:-48px;left:-36px;background:rgba(255,255,255,.24);filter:blur(1px);pointer-events:none
}
.summary-card,.stat-card{
 border-radius:21px!important;box-shadow:0 12px 24px rgba(15,35,70,.13),inset 0 1px 0 rgba(255,255,255,.35)!important
}
h1,h2,h3,.card-title{letter-spacing:.1px}
@keyframes azFloat5d{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
.brand-icon{animation:azFloat5d 4s ease-in-out infinite}
html.az-reduce *,html.az-reduce *:before,html.az-reduce *:after{animation:none!important;scroll-behavior:auto!important;transition:none!important}

@media(max-width:380px){
 .app-container{padding-left:11px;padding-right:11px}
 .card{padding:13px}
 .nav-item{min-width:49px;padding:6px 5px}
}


/* ===== Professional polish: edit dialog, accessibility, record actions ===== */
:focus-visible{outline:3px solid rgba(2,132,199,.55)!important;outline-offset:2px;border-radius:10px}
button,.btn,.nav-item,.icon-btn{touch-action:manipulation}
.record-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.record-actions .btn{width:auto;flex:1 1 120px;padding:9px 12px;font-size:12px}
.btn-edit{background:linear-gradient(135deg,#eff8ff,#dbeafe)!important;color:#075985!important;border:1px solid #bae6fd!important;box-shadow:none!important}
.btn-edit:active{transform:scale(.97)}
#modalRecordForm .rf-help{font-size:11.5px;line-height:1.8;color:#475569;background:#f0f9ff;border:1px solid #bae6fd;border-radius:12px;padding:9px 12px;margin-bottom:12px}
#modalRecordForm .rf-error{display:none;font-size:12px;font-weight:800;color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:9px 12px;margin-bottom:12px}
#modalRecordForm .rf-error.show{display:block}
#modalRecordForm .form-input.invalid,#modalRecordForm .form-select.invalid{border-color:#ef4444!important;background:#fff7f7}
#modalRecordForm .rf-preview{display:flex;justify-content:space-between;align-items:center;background:#f8fafc;border:1px dashed #94a3b8;border-radius:12px;padding:10px 12px;font-size:12.5px;font-weight:800;color:#0f172a;margin-bottom:12px}
#modalRecordForm .rf-preview b{color:#0369a1}

/* Welcome card: later global .card rules force a light background, so keep this one dark and readable */
html body .card.welcome-card{
  background:linear-gradient(135deg,#06152e 0%,#0c3a6b 55%,#0284c7 100%)!important;
  border:1px solid rgba(255,255,255,.14)!important;
  color:#ffffff!important;
  box-shadow:0 12px 28px rgba(6,21,46,.28)!important;
}
html body .card.welcome-card:before{background:linear-gradient(90deg,#38bdf8,#fbbf24)!important}
html body .card.welcome-card .welcome-title{font-size:19px;font-weight:900;color:#ffffff!important;line-height:1.6;text-shadow:0 1px 2px rgba(0,0,0,.25)}
html body .card.welcome-card .welcome-sub{font-size:12px;font-weight:700;color:#e0f2fe!important;line-height:1.7}
#modalRecordForm .rf-actions{position:sticky;bottom:-20px;background:linear-gradient(180deg,rgba(255,255,255,0),#fff 28%);padding:14px 0 6px;margin-bottom:-6px;z-index:2}

/* ===================== AZ Flow — colour grading, 3D & motion ===================== */
.t-home{--sec:#0284c7;--sec2:#38bdf8;--sec-glow:rgba(2,132,199,.38);--sec-soft:#e0f2fe}
.t-customers{--sec:#2563eb;--sec2:#60a5fa;--sec-glow:rgba(37,99,235,.38);--sec-soft:#dbeafe}
.t-shop{--sec:#d97706;--sec2:#fbbf24;--sec-glow:rgba(217,119,6,.40);--sec-soft:#fef3c7}
.t-partner{--sec:#7c3aed;--sec2:#a78bfa;--sec-glow:rgba(124,58,237,.38);--sec-soft:#ede9fe}
.t-household{--sec:#0d9488;--sec2:#2dd4bf;--sec-glow:rgba(13,148,136,.38);--sec-soft:#ccfbf1}
.t-personal{--sec:#db2777;--sec2:#f472b6;--sec-glow:rgba(219,39,119,.36);--sec-soft:#fce7f3}
.t-udhaar{--sec:#059669;--sec2:#34d399;--sec-glow:rgba(5,150,105,.38);--sec-soft:#d1fae5}
.t-analytics{--sec:#4f46e5;--sec2:#818cf8;--sec-glow:rgba(79,70,229,.38);--sec-soft:#e0e7ff}
.t-settings{--sec:#334155;--sec2:#94a3b8;--sec-glow:rgba(51,65,85,.34);--sec-soft:#e2e8f0}

html body{background:radial-gradient(900px 500px at 100% -5%,rgba(56,189,248,.22),transparent 60%),radial-gradient(800px 480px at -10% 30%,rgba(167,139,250,.18),transparent 60%),radial-gradient(700px 500px at 60% 105%,rgba(45,212,191,.16),transparent 60%),linear-gradient(180deg,#eef4fb 0%,#f3f1fb 55%,#eef7f4 100%);background-attachment:fixed;padding-bottom:104px}
html body .top-bar{background:linear-gradient(120deg,#031126 0%,#0a2750 52%,#0c4a86 100%);box-shadow:0 8px 28px rgba(3,17,38,.35)}
html body .top-bar:after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,#38bdf8,#a78bfa,#f472b6,#fbbf24,#34d399)}
.app-container{perspective:1200px}

/* section banners */
html body .screen-content>.card-title:first-child{
  background:linear-gradient(135deg,var(--sec),var(--sec2))!important;border:none!important;color:#fff!important;
  border-radius:22px!important;padding:18px 18px!important;min-height:80px;margin:0 0 16px!important;
  box-shadow:0 7px 0 rgba(0,0,0,.14),0 18px 32px var(--sec-glow),inset 0 1px 0 rgba(255,255,255,.4)!important;
  position:relative;overflow:hidden;text-shadow:0 1px 2px rgba(0,0,0,.18)}
html body .screen-content>.card-title:first-child>span:first-child{color:#fff!important;font-size:16.5px;font-weight:900;position:relative;z-index:1}
html body .screen-content>.card-title:first-child:before{content:"";position:absolute;top:0;bottom:0;left:-60%;width:45%;background:linear-gradient(105deg,transparent,rgba(255,255,255,.34),transparent);transform:skewX(-18deg);animation:azSheen 6s ease-in-out infinite}
html body .screen-content>.card-title:first-child:after{content:"";position:absolute;width:150px;height:150px;border-radius:50%;left:-40px;bottom:-70px;background:rgba(255,255,255,.14)}
html body .screen-content>.card-title:first-child .btn{background:rgba(255,255,255,.22)!important;color:#fff!important;border:1px solid rgba(255,255,255,.5)!important;box-shadow:0 3px 0 rgba(0,0,0,.12)!important;backdrop-filter:blur(6px);position:relative;z-index:1}
@keyframes azSheen{0%,55%{left:-60%}100%{left:130%}}
html body .screen-content>.card-title:not(:first-child){color:color-mix(in srgb,var(--sec) 62%,#0b1b33)}

/* section accents */
html body .screen-content .card:before{background:linear-gradient(90deg,var(--sec),var(--sec2))!important;height:5px}
html body .screen-content .btn-primary{background:linear-gradient(135deg,var(--sec),var(--sec2))!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 5px 0 rgba(0,0,0,.16),0 10px 18px var(--sec-glow)!important;color:#fff}
html body .screen-content .form-input:focus,html body .screen-content .form-select:focus{border-color:var(--sec)!important;box-shadow:0 0 0 4px var(--sec-glow)!important}
html body .screen-content .metric-box{box-shadow:0 5px 0 rgba(15,23,42,.06),0 12px 22px rgba(15,23,42,.07)}
html body .screen-content .item-card{box-shadow:0 5px 0 rgba(15,23,42,.05),0 14px 26px rgba(15,23,42,.08)}

/* screen 3D entrance */
.screen-content.enter>*{animation:az3dIn .6s cubic-bezier(.2,.8,.2,1) backwards;transform-origin:50% 0}
.screen-content.enter>*:nth-child(2){animation-delay:.05s}.screen-content.enter>*:nth-child(3){animation-delay:.1s}
.screen-content.enter>*:nth-child(4){animation-delay:.15s}.screen-content.enter>*:nth-child(5){animation-delay:.2s}
.screen-content.enter>*:nth-child(6){animation-delay:.25s}.screen-content.enter>*:nth-child(n+7){animation-delay:.3s}
@keyframes az3dIn{from{opacity:0;transform:perspective(900px) translateY(26px) rotateX(-14deg) scale(.96)}to{opacity:1;transform:none}}

/* tilt (pointer) */
html body .tilt3d,html body .tilt3d:hover{transform:perspective(800px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) scale(1.015);transition:transform .12s linear}

/* bottom navigation */
html body .bottom-nav{background:rgba(255,255,255,.93);-webkit-backdrop-filter:blur(16px) saturate(1.5);backdrop-filter:blur(16px) saturate(1.5);border-top:1px solid rgba(15,23,42,.06);border-radius:24px 24px 0 0;padding:10px 8px calc(8px + env(safe-area-inset-bottom,0px));gap:4px;justify-content:flex-start;box-shadow:0 -12px 34px rgba(8,30,66,.14);scrollbar-width:none;scroll-behavior:smooth}
.bottom-nav::-webkit-scrollbar{display:none}
html body .bottom-nav .nav-item{min-width:66px;padding:2px 4px 4px;background:transparent;color:#64748b;font-size:10.5px;font-weight:800;gap:5px;border-radius:16px;position:relative}
.nav-item em{font-style:normal;line-height:1.2;white-space:nowrap}
.nav-ico{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:15px;font-size:20px;margin:0!important;background:linear-gradient(145deg,#fff,var(--sec-soft));box-shadow:inset 0 1px 0 #fff,0 3px 0 rgba(15,23,42,.09),0 6px 10px rgba(15,23,42,.06);transition:transform .38s cubic-bezier(.34,1.56,.64,1),box-shadow .3s,background .3s}
html body .bottom-nav .nav-item.active{background:transparent;color:var(--sec)}
html body .bottom-nav .nav-item.active .nav-ico{background:linear-gradient(145deg,var(--sec2),var(--sec));transform:translateY(-7px) scale(1.13);box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 6px 0 rgba(0,0,0,.17),0 16px 22px var(--sec-glow)}
html body .bottom-nav .nav-item.active:after{content:"";position:absolute;bottom:-1px;left:50%;width:20px;height:3px;border-radius:3px;background:var(--sec);transform:translateX(-50%)}
html body .bottom-nav .nav-item:active .nav-ico{transform:translateY(2px) scale(.94)}

/* home quick access */
.quick-head{font-size:13.5px;font-weight:900;color:#15375b;margin:2px 4px 10px}
.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px}
.qtile{border:none;background:linear-gradient(180deg,#fff,#f5f9ff);border-radius:20px;padding:11px 4px 10px;display:flex;flex-direction:column;align-items:center;gap:7px;font-family:inherit;font-size:11px;font-weight:900;color:#1e293b;cursor:pointer;box-shadow:0 6px 0 rgba(15,23,42,.07),0 14px 22px rgba(15,23,42,.08);transition:transform .2s,box-shadow .2s}
.qtile:active{transform:translateY(4px);box-shadow:0 2px 0 rgba(15,23,42,.07),0 6px 10px rgba(15,23,42,.08)}
.q-ico{width:48px;height:48px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:23px;background:linear-gradient(145deg,var(--sec2),var(--sec));box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 5px 0 rgba(0,0,0,.15),0 12px 18px var(--sec-glow);animation:qFloat 4.2s ease-in-out infinite}
.qtile:nth-child(2n) .q-ico{animation-delay:-1.1s}.qtile:nth-child(3n) .q-ico{animation-delay:-2.2s}.qtile:nth-child(5n) .q-ico{animation-delay:-3.1s}
@keyframes qFloat{0%,100%{transform:translateY(0) rotateX(0)}50%{transform:translateY(-4px) rotateX(10deg)}}

/* PIN settings card */
.pin-badge{font-size:11px;font-weight:900;padding:4px 12px;border-radius:20px;background:#f1f5f9;color:#475569}
.pin-badge.on{background:#d1fae5;color:#047857}
.pin-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.pin-actions .btn{width:100%}

/* PIN lock screen */
#pinLock{position:fixed;inset:0;z-index:100000;display:none;align-items:center;justify-content:center;background:radial-gradient(700px 500px at 80% 0,rgba(56,189,248,.28),transparent 60%),radial-gradient(600px 500px at 0 100%,rgba(167,139,250,.25),transparent 60%),linear-gradient(160deg,#020617,#06152e 55%,#0b2f5e);color:#fff;font-family:inherit;overflow:hidden;perspective:1000px}
#pinLock.show{display:flex}
#pinLock:before,#pinLock:after{content:"";position:absolute;border-radius:50%;filter:blur(2px);animation:pinOrb 9s ease-in-out infinite}
#pinLock:before{width:220px;height:220px;top:-60px;left:-60px;background:radial-gradient(circle at 30% 30%,#38bdf8,transparent 70%);opacity:.5}
#pinLock:after{width:260px;height:260px;bottom:-90px;right:-70px;background:radial-gradient(circle at 30% 30%,#a78bfa,transparent 70%);opacity:.45;animation-delay:-4s}
@keyframes pinOrb{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(20px,24px,0) scale(1.12)}}
.pin-card{position:relative;z-index:1;width:min(92vw,340px);text-align:center;padding:10px 4px;max-height:100vh;overflow-y:auto}
.pin-logo{width:78px;height:78px;margin:0 auto 12px;border-radius:26px;display:flex;align-items:center;justify-content:center;font-size:36px;background:linear-gradient(145deg,#38bdf8,#0369a1);box-shadow:inset 0 2px 0 rgba(255,255,255,.5),0 8px 0 rgba(0,0,0,.28),0 22px 36px rgba(2,132,199,.5);animation:qFloat 3.6s ease-in-out infinite}
.pin-card h2{font-size:19px;font-weight:900;margin-bottom:4px}
.pin-card p{font-size:12px;color:#bae6fd;line-height:1.8;min-height:22px}
.pin-dots{display:flex;justify-content:center;gap:14px;margin:16px 0 8px}
.pin-dots i{width:15px;height:15px;border-radius:50%;border:2px solid rgba(255,255,255,.6);transition:all .18s}
.pin-dots i.on{background:#38bdf8;border-color:#38bdf8;box-shadow:0 0 14px rgba(56,189,248,.9);transform:scale(1.15)}
.pin-dots.shake{animation:pinShake .45s}
@keyframes pinShake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-10px)}40%,80%{transform:translateX(10px)}}
#pinMsg{min-height:20px;font-size:12px;font-weight:800;color:#fca5a5;margin-bottom:6px}
.pin-pad{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:8px auto 12px;max-width:290px;direction:ltr}
.pin-key{height:62px;border:none;border-radius:20px;font-family:inherit;font-size:24px;font-weight:800;color:#fff;cursor:pointer;background:linear-gradient(180deg,rgba(255,255,255,.2),rgba(255,255,255,.07));border:1px solid rgba(255,255,255,.22);box-shadow:0 6px 0 rgba(0,0,0,.35),0 14px 20px rgba(0,0,0,.25);transition:transform .08s,box-shadow .08s}
.pin-key:active{transform:translateY(5px);box-shadow:0 1px 0 rgba(0,0,0,.35)}
.pin-key.ghost{background:transparent;border-color:transparent;box-shadow:none;font-size:20px}
.pin-link{background:none;border:none;color:#7dd3fc;font-family:inherit;font-size:12.5px;font-weight:800;padding:8px;cursor:pointer;text-decoration:underline}
.pin-reccode{font-size:30px;font-weight:900;letter-spacing:6px;direction:ltr;background:rgba(255,255,255,.1);border:1px dashed rgba(255,255,255,.5);border-radius:18px;padding:16px 8px;margin:14px 0;color:#fde68a}

/* ===== AZ Flow motion layer: depth, 3D and micro-interactions ===== */

  @keyframes azAurora{0%{background-position:0% 40%}50%{background-position:100% 60%}100%{background-position:0% 40%}}
  @keyframes azPopIn{0%{opacity:0;transform:perspective(900px) translateY(34px) rotateX(-16deg) scale(.92)}60%{opacity:1;transform:perspective(900px) translateY(-4px) rotateX(2deg) scale(1.01)}100%{opacity:1;transform:none}}
  @keyframes azFadeIn{from{opacity:0}to{opacity:1}}
  @keyframes azToastIn{0%{opacity:0;transform:translate(-50%,24px) scale(.9)}65%{transform:translate(-50%,-4px) scale(1.03)}100%{opacity:1;transform:translate(-50%,0) scale(1)}}
  @keyframes azNavPop{0%{transform:translateY(0) scale(1)}45%{transform:translateY(-13px) scale(1.2) rotate(-4deg)}100%{transform:translateY(-7px) scale(1.13)}}
  @keyframes azBob{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-5px) rotate(6deg)}}
  @keyframes azOrb{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(-18px,14px,0) scale(1.18)}}
  @keyframes azRipple{to{transform:scale(3.4);opacity:0}}
  @keyframes azRise{from{opacity:0;transform:perspective(700px) translateY(18px) rotateX(-10deg)}to{opacity:1;transform:none}}
  @keyframes azSplashLogo{0%{opacity:0;transform:perspective(700px) rotateY(-100deg) scale(.5)}60%{opacity:1;transform:perspective(700px) rotateY(12deg) scale(1.06)}100%{opacity:1;transform:perspective(700px) rotateY(0) scale(1)}}
  @keyframes azGlowPulse{0%,100%{box-shadow:0 10px 24px rgba(2,132,199,.28)}50%{box-shadow:0 14px 34px rgba(2,132,199,.5)}}
  @keyframes azBar{from{transform:scaleX(0)}to{transform:scaleX(1)}}

  html body .top-bar{background-size:230% 230%;animation:azAurora 16s ease-in-out infinite}
  html body .welcome-card{background-size:220% 220%!important;animation:azAurora 12s ease-in-out infinite}
  html body .welcome-card:after{content:"";position:absolute;width:150px;height:150px;border-radius:50%;left:-40px;bottom:-60px;background:radial-gradient(circle at 35% 35%,rgba(125,211,252,.55),transparent 70%);animation:azOrb 8s ease-in-out infinite;pointer-events:none}
  html body .welcome-card span[style*="font-size:30px"]{display:inline-block;animation:azBob 3.6s ease-in-out infinite;filter:drop-shadow(0 8px 8px rgba(0,0,0,.35))}
  html body #splashScreen .splash-logo{animation:azSplashLogo 1s cubic-bezier(.2,.9,.25,1.1) both}
  html body .modal-overlay{animation:azFadeIn .22s ease-out}
  html body .modal-box{animation:azPopIn .5s cubic-bezier(.2,.9,.25,1.15) both;transform-origin:50% 100%}
  html body #toast{animation:azToastIn .45s cubic-bezier(.2,.9,.25,1.2) both}
  html body .bottom-nav .nav-item.active .nav-ico{animation:azNavPop .5s cubic-bezier(.3,1.4,.5,1) both}
  html body .quick-grid .qtile{animation:azRise .55s cubic-bezier(.2,.8,.2,1) backwards}
  html body .quick-grid .qtile:nth-child(2){animation-delay:.05s}html body .quick-grid .qtile:nth-child(3){animation-delay:.1s}
  html body .quick-grid .qtile:nth-child(4){animation-delay:.15s}html body .quick-grid .qtile:nth-child(5){animation-delay:.2s}
