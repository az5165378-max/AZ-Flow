<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#06152e">
  <meta name="description" content="AZ Flow — کسٹمر، ادھار، دکانداری، پارٹنرشپ اور خرچوں کا آل اِن ون موبائل مینجمنٹ سسٹم">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="AZ Flow">
  <meta name="format-detection" content="telephone=no">
  <title>AZ Flow 0.1 - آل اِن ون مینجمنٹ ایپ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@300;400;500;600&family=Noto+Naskh+Arabic:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
/* ===== AZ Flow typography: clean Naskh Urdu (no Nastaliq). Embedded so it works offline ===== */
@font-face{font-family:'AZ Urdu';font-style:normal;font-weight:100 800;font-display:swap;size-adjust:108%;unicode-range:U+0600-06FF,U+0750-077F,U+FB50-FDFF,U+FE70-FEFF,U+200C-200F;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'AZ Urdu';font-style:normal;font-weight:900;font-display:swap;size-adjust:108%;unicode-range:U+0600-06FF,U+0750-077F,U+FB50-FDFF,U+FE70-FEFF,U+200C-200F;src:url(data:font/woff;base64,) format('woff')}
:root{--az-font:'Plus Jakarta Sans','Noto Sans Arabic','Noto Naskh Arabic','AZ Urdu',system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}
html.az-font-naskh{--az-font:'Plus Jakarta Sans','Noto Naskh Arabic','Noto Sans Arabic','AZ Urdu',system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}
html,body,button,input,select,textarea{font-family:var(--az-font)}
body{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;font-feature-settings:"kern","liga","calt"}

    :root {
      --primary: #0284c7;
      --primary-dark: #0369a1;
      --primary-light: #38bdf8;
      --accent: #f59e0b;
      --profit: #10b981;
      --expense: #ef4444;
      --pending: #f59e0b;
      --done: #059669;
      --bg-dark: #06152e;
      --surface: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #cbd5e1;
      --border-light: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
      --shadow-md: 0 4px 12px rgba(0,0,0,.1);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 20px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: var(--az-font);
      background-color: #f1f5f9;
      color: var(--text);
      min-height: 100vh;
      direction: rtl;
      padding-bottom: 84px;
    }
    /* Splash Screen */
    #splashScreen {
      position: fixed; inset: 0; background: linear-gradient(135deg, #020617 0%, #06152e 50%, #0f172a 100%);
      color: #ffffff; z-index: 99999; display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; transition: opacity .5s ease, visibility .5s ease;
    }
    .splash-logo {
      width: 112px; height: 112px; padding: 5px; overflow: hidden;
      background: linear-gradient(145deg, #dbeafe, #38bdf8 45%, #08264c 80%);
      border: 1px solid rgba(255,255,255,.72); border-radius: 28px;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 18px 38px rgba(2,132,199,.45), inset 0 2px 5px rgba(255,255,255,.7);
      margin-bottom: 20px; animation: pulse 1.6s infinite ease-in-out;
    }
    .splash-logo img { display:block; width:100%; height:100%; object-fit:cover; border-radius:22px; }
    .splash-title { font-size: 32px; font-weight: 900; letter-spacing: -0.5px; }
    .splash-subtitle { font-family: var(--az-font); font-size: 16px; color: #94a3b8; margin-top: 6px; }
    .splash-credit {
      position: absolute; bottom: 32px; font-size: 12px; color: #64748b; font-weight: 700;
      letter-spacing: 0.5px; text-transform: uppercase;
    }
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }

    /* Top App Bar */
    .top-bar {
      background: linear-gradient(135deg, #06152e 0%, #0c234a 100%);
      color: #ffffff; padding: 14px 18px; position: sticky; top: 0; z-index: 100;
      box-shadow: 0 4px 20px rgba(6,21,46,.25); border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .top-bar-inner { max-width: 680px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .brand-group { display: flex; align-items: center; gap: 12px; }
    .brand-icon {
      width: 42px; height: 42px; background: linear-gradient(135deg, #0284c7, #38bdf8);
      border-radius: 12px; display: flex; align-items: center; justify-content: center;
      font-size: 22px; box-shadow: 0 4px 12px rgba(2,132,199,.35);
    }
    .brand-text h1 { font-size: 18px; font-weight: 900; line-height: 1.2; }
    .brand-text p { font-size: 10px; color: #93c5fd; font-weight: 700; }
    .top-actions { display: flex; gap: 8px; }
    .icon-btn {
      width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,.1);
      border: 1px solid rgba(255,255,255,.12); color: #ffffff; display: flex;
      align-items: center; justify-content: center; font-size: 16px; cursor: pointer;
      transition: background .2s;
    }
    .icon-btn:hover { background: rgba(255,255,255,.2); }

    /* Container */
    .app-container { max-width: 680px; margin: 0 auto; padding: 16px; }

    /* Bottom Navigation */
    .bottom-nav {
      position: fixed; bottom: 0; left: 0; right: 0; background: #ffffff;
      border-top: 1px solid var(--border-light); display: flex; justify-content: space-around;
      padding: 8px 6px; z-index: 150; box-shadow: 0 -4px 16px rgba(0,0,0,.06); overflow-x:auto; gap:2px;
    }
    .nav-item {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      color: var(--muted); font-size: 10.5px; font-weight: 700; cursor: pointer;
      padding: 6px 7px; min-width:54px; flex:0 0 auto; border-radius: 10px; transition: all .2s; border: none; background: transparent;
    }
    .nav-item.active { color: var(--primary); background: #e0f2fe; }
    .nav-item span { font-size: 19px; margin-bottom: 2px; }

    /* Cards */
    .card {
      background: var(--surface); border-radius: var(--radius-lg); padding: 16px;
      box-shadow: var(--shadow-sm); border: 1px solid var(--border-light); margin-bottom: 16px;
    }
    .card-title {
      font-size: 14.5px; font-weight: 800; color: var(--text); margin-bottom: 12px;
      display: flex; align-items: center; justify-content: space-between;
    }

    /* Metric Grids */
    .metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
    .metric-box {
      background: #f8fafc; border-radius: var(--radius-md); padding: 12px 10px;
      border: 1px solid var(--border-light); text-align: center;
    }
    .metric-box.primary { background: #e0f2fe; border-color: #bae6fd; }
    .metric-box.profit { background: #ecfdf5; border-color: #a7f3d0; }
    .metric-box.cost { background: #fff1f2; border-color: #fecdd3; }
    .metric-label { font-size: 11px; font-weight: 700; color: var(--muted); margin-bottom: 4px; }
    .metric-val { font-size: 16px; font-weight: 900; }
    .metric-box.primary .metric-val { color: var(--primary-dark); }
    .metric-box.profit .metric-val { color: var(--profit); }
    .metric-box.cost .metric-val { color: var(--expense); }

    /* Presets Chips */
    .chips-row { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 14px; }
    .chip {
      background: #f1f5f9; border: 1px solid var(--border); border-radius: 20px;
      padding: 5px 11px; font-size: 11.5px; font-weight: 700; color: #334155;
      cursor: pointer; transition: all .15s; display: flex; align-items: center; gap: 4px;
    }
    .chip:hover, .chip:active { background: #e0f2fe; border-color: var(--primary); color: var(--primary-dark); }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      font-weight: 800; border-radius: var(--radius-md); padding: 11px 18px;
      font-size: 13.5px; cursor: pointer; border: none; transition: all .2s; width: 100%;
    }
    .btn-primary { background: var(--primary); color: #fff; box-shadow: 0 4px 12px rgba(2,132,199,.25); }
    .btn-primary:hover { background: var(--primary-dark); }
    .btn-success { background: var(--profit); color: #fff; }
    .btn-outline { background: transparent; border: 1.5px solid var(--border); color: var(--text); }
    .btn-outline:hover { background: #f8fafc; }
    .btn-danger { background: #ef4444; color: #fff; }
    .btn-whatsapp { background: #25D366; color: #fff; box-shadow: 0 4px 12px rgba(37,211,102,.25); }
    .btn-whatsapp:hover { background: #1eb855; }

    /* Form Fields */
    .form-group { margin-bottom: 12px; }
    .form-label { display: block; font-size: 12px; font-weight: 800; color: #334155; margin-bottom: 5px; }
    .form-input, .form-select, .form-textarea {
      width: 100%; border: 1.5px solid var(--border); border-radius: var(--radius-md);
      padding: 10px 14px; font-size: 13.5px; font-family: inherit; background: #fff;
      color: var(--text); transition: border-color .2s;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
      outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(2,132,199,.15);
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    /* Receipt & Item Cards */
    .item-card {
      background: var(--surface); border: 1.5px solid var(--border-light);
      border-radius: var(--radius-lg); padding: 16px; margin-bottom: 14px;
      box-shadow: 0 2px 8px rgba(0,0,0,.04); position: relative; overflow: hidden;
    }
    .item-card.is-done { border-right: 5px solid var(--done); }
    .item-card.is-pending { border-right: 5px solid var(--pending); }

    .item-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
    .item-customer-name { font-size: 16px; font-weight: 900; color: #0f172a; margin-bottom: 2px; }
    .item-work { font-size: 13px; color: var(--primary-dark); font-weight: 700; }
    .item-date { font-size: 11px; color: var(--muted); }

    /* Receipt Box inside item */
    .receipt-box {
      background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: var(--radius-md);
      padding: 12px; margin: 10px 0;
    }
    .receipt-row { display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 6px; }
    .receipt-row.bold { font-weight: 800; font-size: 13.5px; border-top: 1px solid #e2e8f0; padding-top: 6px; margin-top: 6px; }
    .receipt-row .val { font-weight: 800; }

    /* Status Badges - Bold & Prominent */
    .status-badge {
      display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px;
      border-radius: 30px; font-size: 12.5px; font-weight: 900; margin: 8px 0;
    }
    .badge-done { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
    .badge-pending { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }

    /* Action Buttons Row */
    .item-actions {
      display: flex; gap: 8px; margin-top: 12px; padding-top: 10px;
      border-top: 1px solid var(--border-light);
    }
    .item-actions button { flex: 1; padding: 8px 6px; font-size: 12px; border-radius: 8px; font-weight: 700; }

    /* Udhaar Specific */
    .udhaar-badge {
      display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px;
      border-radius: 8px; font-size: 11.5px; font-weight: 800;
    }
    .udhaar-lena { background: #dcfce7; color: #166534; }
    .udhaar-dena { background: #fee2e2; color: #991b1b; }

    /* Modals */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(15,23,42,.65); backdrop-filter: blur(4px);
      z-index: 500; display: none; align-items: center; justify-content: center; padding: 16px;
    }
    .modal-box {
      background: #ffffff; width: 100%; max-width: 500px; max-height: 90vh;
      overflow-y: auto; border-radius: var(--radius-xl); padding: 20px;
      box-shadow: 0 20px 40px rgba(0,0,0,.25); position: relative;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .close-btn { background: none; border: none; font-size: 24px; color: var(--muted); cursor: pointer; }

    /* Toast */
    #toast {
      position: fixed; bottom: 95px; left: 50%; transform: translateX(-50%);
      background: #0f172a; color: #fff; padding: 10px 20px; border-radius: 30px;
      font-size: 12.5px; font-weight: 700; z-index: 9999; display: none;
      box-shadow: 0 4px 20px rgba(0,0,0,.3); white-space: nowrap;
    }

    /* AZ FLOW PROFESSIONAL 3D VISUAL UPGRADE — UI ONLY */
    :root {
      --primary: #0878f9;
      --primary-dark: #0754b8;
      --primary-light: #54c8ff;
      --accent: #ffbf47;
      --profit: #08b981;
      --expense: #f04462;
      --pending: #f5a524;
      --done: #079669;
      --bg-dark: #06142e;
      --surface: #ffffff;
      --text: #101b31;
      --muted: #64748b;
      --border: #cbd8e8;
      --border-light: #e4ebf5;
      --shadow-sm: 0 5px 14px rgba(9, 30, 66, .07);
      --shadow-md: 0 12px 28px rgba(9, 30, 66, .12);
      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 19px;
      --radius-xl: 24px;
    }
    body {
      background: radial-gradient(ellipse at top right, rgba(84,200,255,.13), transparent 36%),
                  linear-gradient(145deg, #edf4fc 0%, #f7f9fd 48%, #eaf1fb 100%);
      background-attachment: fixed;
    }
    .top-bar {
      background: linear-gradient(135deg, #041027 0%, #0a2450 55%, #0b3b70 100%);
      box-shadow: 0 8px 24px rgba(3, 18, 46, .28);
      border-bottom: 1px solid rgba(117, 203, 255, .24);
    }
    .brand-icon, .splash-logo {
      background: linear-gradient(145deg, #071a3b 0%, #0878f9 48%, #8ce0ff 100%);
      border: 1px solid rgba(255,255,255,.35);
      box-shadow: inset 0 2px 3px rgba(255,255,255,.38), inset 0 -5px 9px rgba(0,20,65,.25), 0 8px 18px rgba(8,120,249,.32);
    }
    .app-container { padding-top: 18px; }
    .card {
      background: linear-gradient(150deg, rgba(255,255,255,.99), rgba(247,250,255,.97));
      border: 1px solid rgba(202, 218, 239, .9);
      box-shadow: 0 3px 0 rgba(10, 47, 91, .035), 0 9px 22px rgba(12, 40, 82, .075);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .metric-box {
      box-shadow: inset 0 1px 0 rgba(255,255,255,.95), 0 4px 10px rgba(11, 36, 75, .055);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .metric-box.primary { background: linear-gradient(145deg, #eaf6ff, #d9edff); }
    .metric-box.profit { background: linear-gradient(145deg, #eafff6, #d9f9eb); }
    .metric-box.cost { background: linear-gradient(145deg, #fff0f2, #ffe2e7); }
    .btn {
      box-shadow: 0 4px 0 rgba(5, 35, 79, .10), 0 7px 13px rgba(5, 35, 79, .08);
      transform: translateY(0);
    }
    .btn:active { transform: translateY(2px); box-shadow: 0 2px 0 rgba(5, 35, 79, .10); }
    .btn-primary { background: linear-gradient(135deg, #168bff, #075acb); box-shadow: inset 0 1px 0 rgba(255,255,255,.28), 0 5px 0 #06458f, 0 9px 16px rgba(8,120,249,.2); }
    .btn-success { background: linear-gradient(135deg, #16c997, #07845f); }
    .btn-danger { background: linear-gradient(135deg, #ff6678, #d92343); }
    .btn-whatsapp { background: linear-gradient(135deg, #35e47d, #0ca957); }
    .btn-outline { background: linear-gradient(145deg, #fff, #f0f5fc); border-color: #c8d7ea; }
    .form-input, .form-select, .form-textarea { box-shadow: inset 0 2px 4px rgba(10,35,70,.035); }
    .item-card {
      background: linear-gradient(145deg, #ffffff 0%, #f8fbff 100%);
      border-color: #dce6f3;
      box-shadow: 0 3px 0 rgba(8, 39, 82, .035), 0 9px 20px rgba(8, 39, 82, .075);
    }
    .item-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #0878f9, #54c8ff, #a9e9ff); opacity: .8; }
    .item-card.is-done::before { background: linear-gradient(90deg, #079669, #53e6b3); }
    .item-card.is-pending::before { background: linear-gradient(90deg, #f5a524, #ffdc79); }
    .status-badge { box-shadow: inset 0 1px 0 rgba(255,255,255,.8), 0 3px 7px rgba(12,35,70,.06); }
    .receipt-box { box-shadow: inset 0 1px 0 rgba(255,255,255,.95), 0 3px 9px rgba(12,35,70,.035); }
    .bottom-nav {
      background: rgba(255,255,255,.94);
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid rgba(195, 211, 232, .9);
      box-shadow: 0 -8px 24px rgba(6, 24, 55, .09);
    }
    .nav-item.active {
      color: #075acb; background: linear-gradient(145deg, #e7f4ff, #d7ebff);
      box-shadow: inset 0 1px 0 #fff, 0 3px 8px rgba(8,120,249,.1);
    }
    .modal-box { border: 1px solid rgba(255,255,255,.8); box-shadow: 0 24px 65px rgba(0,12,35,.32); }
    #toast { background: linear-gradient(135deg, #06142e, #123b72); border: 1px solid rgba(255,255,255,.15); }
    .backup-warning-card {
      display: flex; align-items: flex-start; gap: 12px; margin: 0 0 15px; padding: 15px;
      color: #7f1d1d; border: 1px solid #f87171; border-right: 6px solid #dc2626;
      border-radius: 17px; background: linear-gradient(145deg, #fff7f7 0%, #ffe1e1 100%);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.95), 0 5px 0 rgba(153,27,27,.07), 0 10px 20px rgba(153,27,27,.11);
    }
    .backup-warning-icon { flex: 0 0 42px; width: 42px; height: 42px; display:flex; align-items:center; justify-content:center;
      font-size: 23px; border-radius: 13px; background: linear-gradient(145deg,#ffb4b4,#ef4444);
      box-shadow: inset 0 2px 2px rgba(255,255,255,.65), 0 4px 9px rgba(185,28,28,.2); }
    .backup-warning-content { min-width: 0; }
    .backup-warning-content h3 { font-size: 14px; line-height: 1.8; font-weight: 900; color: #991b1b; margin: 0 0 5px; }
    .backup-warning-content p { font-size: 12px; line-height: 1.9; font-weight: 700; color: #7f1d1d; margin: 0 0 6px; }
    .backup-warning-content strong { display: block; font-size: 11.5px; line-height: 1.9; color: #991b1b; background: rgba(255,255,255,.6); border-radius: 9px; padding: 6px 8px; }
    @media (hover:hover) {
      .card:hover, .metric-box:hover, .item-card:hover { transform: translateY(-2px); box-shadow: 0 5px 0 rgba(10,47,91,.035), 0 13px 25px rgba(12,40,82,.10); }
    }
    @media (max-width: 380px) { .backup-warning-card { padding: 11px; gap: 9px; } .backup-warning-icon { flex-basis: 34px; width: 34px; height: 34px; font-size: 19px; } .backup-warning-content h3 { font-size: 12.5px; } .backup-warning-content p { font-size: 11px; } }
    html.az-reduce *,html.az-reduce *::before,html.az-reduce *::after{ animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }


    /* Premium step-by-step guide with CSS 3D illustrations */
    .guide-shell{margin:14px 0 18px;border-radius:22px;overflow:hidden;background:linear-gradient(180deg,#f8fbff,#fff);border:1px solid #dbeafe;box-shadow:0 12px 30px rgba(15,23,42,.08);}
    .guide-hero{position:relative;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:22px 18px;background:radial-gradient(circle at 12% 10%,rgba(56,189,248,.28),transparent 35%),linear-gradient(135deg,#06152e,#0c234a 60%,#075985);color:white;min-height:170px;overflow:hidden}
    .guide-hero-copy{position:relative;z-index:2;max-width:68%}.guide-kicker{font:800 9px 'Plus Jakarta Sans',sans-serif;letter-spacing:1.4px;color:#7dd3fc;direction:ltr;display:block;text-align:right}.guide-hero h2{font-size:20px;line-height:1.65;font-weight:900;margin:7px 0}.guide-hero p{font-size:11px;line-height:1.9;color:#dbeafe}
