          b.items.forEach((it, i) => {
            const x = W - M - (i + 1) * w - i * gap;
            ctx.fillStyle = "#fff"; ctx.strokeStyle = C.line; azdRound(ctx, x, y, w, 68, 14); ctx.fill(); ctx.stroke();
            ctx.fillStyle = it.color || C.accent; azdRound(ctx, x + w - 5, y + 12, 4, 44, 2); ctx.fill();
            azdText(ctx, it.label, x + w / 2, y + 20, { size: 11.5, weight: 700, color: C.mute, align: "center" });
            azdText(ctx, it.value, x + w / 2, y + 46, { size: 16, weight: 900, color: it.color || C.ink, align: "center", dir: "ltr" });
          });
          y += 84;
        }
        else if (b.type === "parties") {
          const gap = 10, w = (W - 2 * M - gap) / 2; need(92);
          b.items.forEach((it, i) => {
            const x = W - M - (i + 1) * w - i * gap;
            ctx.fillStyle = "#f8fafc"; ctx.strokeStyle = C.line; azdRound(ctx, x, y, w, 74, 14); ctx.fill(); ctx.stroke();
            ctx.fillStyle = it.color || C.accent; azdRound(ctx, x + w - 5, y + 12, 4, 50, 2); ctx.fill();
            azdText(ctx, it.label, x + w / 2, y + 22, { size: 11.5, weight: 500, color: C.mute, align: "center" });
            let sz = 16; azdFont(ctx, sz, 600); while (it.name && ctx.measureText(it.name).width > w - 30 && sz > 10) { sz--; azdFont(ctx, sz, 600); }
            azdText(ctx, it.name || "—", x + w / 2, y + 50, { size: sz, weight: 600, color: it.name ? C.ink : "#94a3b8", align: "center" });
          });
          y += 90;
        }
        else if (b.type === "badge") {
