          ctx.setLineDash([]);
          azdText(ctx, b.rightLabel || b.left || "دستخط / مہر (وصول کنندہ)", W - M - 95, y + 68, { size: 12, color: C.mute, align: "center" });
          azdText(ctx, b.leftLabel || b.right || "دستخط (ادا کنندہ)", M + 95, y + 68, { size: 12, color: C.mute, align: "center" });
          if (b.rightName) azdText(ctx, b.rightName, W - M - 95, y + 34, { size: 13.5, weight: 600, color: C.ink, align: "center" });
