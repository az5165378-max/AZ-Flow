      wrap.className = "modal-overlay";
      wrap.setAttribute("role", "dialog");
      wrap.setAttribute("aria-modal", "true");
      wrap.innerHTML = `<div class="modal-box">
        <div class="modal-header">
          <h3 id="rfTitle" style="color:var(--bg-dark); font-size:16px; font-weight:900;"></h3>
          <button class="close-btn" type="button" aria-label="بند کریں" onclick="closeRecordForm()">&times;</button>
        </div>
        <div id="rfHelp" class="rf-help" style="display:none"></div>
        <div id="rfError" class="rf-error" role="alert"></div>
        <div id="rfFields"></div>
        <div id="rfPreview"></div>
        <div class="rf-actions" style="display:flex; gap:8px; margin-top:16px;">
          <button class="btn btn-success" type="button" id="rfSubmit" onclick="submitRecordForm()">محفوظ کریں</button>
          <button class="btn btn-outline" type="button" onclick="closeRecordForm()">منسوخ</button>
