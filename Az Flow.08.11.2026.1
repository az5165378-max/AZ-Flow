/* ===== guide: step-by-step, numbered, animated ===== */
.guide-3d.teal{background:linear-gradient(145deg,#ccfbf1,#2dd4bf)}.guide-3d.indigo{background:linear-gradient(145deg,#e0e7ff,#818cf8)}.guide-3d.amber{background:linear-gradient(145deg,#ffedd5,#f97316)}
html body .guide-count{font:800 9.5px 'Plus Jakarta Sans',sans-serif;color:#0369a1;background:#e0f2fe;border:1px solid #bae6fd;border-radius:20px;padding:3px 9px;white-space:nowrap}
html body .guide-body ol{list-style:none;counter-reset:gs;padding:2px 0 0;margin:0}
html body .guide-body li{counter-increment:gs;position:relative;margin:0;padding:6px 40px 10px 2px;line-height:2}
html body .guide-body li:before{content:counter(gs);position:absolute;right:2px;top:6px;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font:800 12px 'Plus Jakarta Sans',sans-serif;color:#fff;background:linear-gradient(135deg,#0ea5e9,#6366f1);box-shadow:0 4px 10px rgba(79,70,229,.3)}
html body .guide-body li:not(:last-child):after{content:"";position:absolute;right:14px;top:34px;bottom:-2px;width:2px;border-radius:2px;background:linear-gradient(#bae6fd,rgba(186,230,253,0))}
html body .guide-item{animation:azRise .45s cubic-bezier(.2,.8,.2,1) backwards}
html body .guide-item[open] .guide-body li{animation:azRise .4s cubic-bezier(.2,.8,.2,1) backwards}
html body .guide-item[open] .guide-body li:nth-child(2){animation-delay:.05s}html body .guide-item[open] .guide-body li:nth-child(3){animation-delay:.1s}html body .guide-item[open] .guide-body li:nth-child(4){animation-delay:.15s}html body .guide-item[open] .guide-body li:nth-child(n+5){animation-delay:.2s}
html body .guide-item[open] .guide-3d{animation:azBob 3.2s ease-in-out infinite}
html body .guide-item[open] .guide-summary b{color:#0369a1}
html body .guide-item summary:active{transform:scale(.99)}
html.az-reduce .guide-item,html.az-reduce .guide-item[open] .guide-body li,html.az-reduce .guide-item[open] .guide-3d{animation:none!important}
html.az-lite .guide-item[open] .guide-3d{animation:none!important}
</style>
